new file mode 100644
index 0000000..8c5949e
--- /dev/null
+++ b/backend/app/migrations.py
@@ -0,0 +1,64 @@
+"""
+Tiny, idempotent schema migration run on every start-up.
+
+`Base.metadata.create_all()` creates missing *tables* but never adds new *columns* to tables
+that already exist, so anyone upgrading an existing database would hit "column does not exist".
+`ensure_schema` adds any model column that is missing (it works on PostgreSQL and SQLite),
+then back-fills the violation `level` / `source` for rows recorded before those columns existed.
+"""
+from __future__ import annotations
+
+import logging
+
+from sqlalchemy import inspect, text
+from sqlalchemy.engine import Engine
+from sqlalchemy.schema import CreateColumn
+
+from app.database import Base
+from app.policy import classify_level, infer_source
+
+logger = logging.getLogger("migrations")
+
+
+def _quote(engine: Engine, name: str) -> str:
+    return engine.dialect.identifier_preparer.quote(name)
+
+
+def ensure_schema(engine: Engine) -> list[str]:
+    """Add missing columns. Returns the list of `table.column` names that were added."""
+    added: list[str] = []
+    inspector = inspect(engine)
+
+    for table in Base.metadata.sorted_tables:
+        if not inspector.has_table(table.name):
+            continue  # create_all() handles brand-new tables
+        existing = {column["name"] for column in inspector.get_columns(table.name)}
+        for column in table.columns:
+            if column.name in existing:
+                continue
+            ddl = CreateColumn(column).compile(dialect=engine.dialect)
+            with engine.begin() as connection:
+                connection.execute(text(f"ALTER TABLE {_quote(engine, table.name)} ADD COLUMN {ddl}"))
+            added.append(f"{table.name}.{column.name}")
+            logger.info("Added column %s.%s", table.name, column.name)
+
+    _backfill_violation_levels(engine)
+    return added
+
+
+def _backfill_violation_levels(engine: Engine) -> None:
+    inspector = inspect(engine)
+    if not inspector.has_table("violations"):
+        return
+    with engine.begin() as connection:
+        rows = connection.execute(
+            text("SELECT id, violation_type FROM violations WHERE level IS NULL")
+        ).fetchall()
+        for row_id, violation_type in rows:
+            source = infer_source(violation_type or "")
+            connection.execute(
+                text("UPDATE violations SET level = :level, source = :source WHERE id = :id"),
+                {"level": classify_level(violation_type or "", source), "source": source, "id": row_id},
+            )
+        if rows:
+            logger.info("Back-filled level/source on %d legacy violations", len(rows))
