+/**
+ * Voice (talking) detector for exam proctoring.
+ *
+ * The previous implementation flagged "talking" whenever the 300-3400 Hz band was louder than the
+ * rest of the spectrum. A desk fan, air-conditioner or street noise easily satisfies that, so
+ * candidates were flagged for noise that is not speech.
+ *
+ * This detector instead scores how *speech-like* a sound is, from four independent cues:
+ *
+ *   1. Level above the learned noise floor  - steady background noise is learned and ignored
+ *   2. Pitch / harmonicity                  - voiced speech is periodic (75-400 Hz); fans are not
+ *   3. Spectral flatness (voice band)       - noise is flat, speech has peaks (harmonics, formants)
+ *   4. Temporal modulation                  - speech rises and falls ~4x per second; a fan is constant
+ *
+ * The cues are combined into a confidence score between 0 and 1 over a short rolling window.
+ * A violation is only raised when the confidence stays above the admin-configured threshold for
+ * the admin-configured duration. All maths is pure (no Web Audio objects) so it is unit-testable.
+ */
+
+export const DEFAULT_DETECTOR_CONFIG = {
+  confidenceThreshold: 0.7, // 0..1 - minimum voice-likelihood
+  minDurationSeconds: 4, // speech must be sustained for this long
+  calibrationSeconds: 5, // learn the room's background noise before judging
+  cooldownSeconds: 10, // minimum gap between two reports from this browser
+  windowSeconds: 2, // rolling window used to judge "is somebody talking right now"
+};
+
+const VOICE_LOW_HZ = 300;
+const VOICE_HIGH_HZ = 3400;
+const PITCH_MIN_HZ = 75;
+const PITCH_MAX_HZ = 400;
+const MIN_DB = -120;
+const PITCH_ANALYSIS_RATE = 16000; // pitch is estimated on a ~16 kHz decimated copy (much cheaper)
+
+const clamp01 = (value) => Math.min(1, Math.max(0, value));
+
+// ---------------------------------------------------------------------------
+// Feature extraction (pure functions)
+// ---------------------------------------------------------------------------
+
+/** Mean power of a frame in dB (relative to full scale). */
+export function frameLevelDb(samples) {
+  let sum = 0;
+  for (let i = 0; i < samples.length; i += 1) sum += samples[i] * samples[i];
+  return 10 * Math.log10(sum / Math.max(1, samples.length) + 1e-12);
+}
+
+/**
+ * Energy and spectral flatness of the human-voice band.
+ * `freqDb` is AnalyserNode.getFloatFrequencyData output (dB per bin, fftSize / 2 bins).
+ * Flatness is geometric-mean / arithmetic-mean of the bin powers: ~0.5 for noise, much lower for speech.
+ */
+export function voiceBandStats(freqDb, sampleRate) {
+  const binCount = freqDb.length;
+  const binHz = sampleRate / (2 * binCount);
+  const low = Math.max(1, Math.ceil(VOICE_LOW_HZ / binHz));
+  const high = Math.min(binCount - 1, Math.floor(VOICE_HIGH_HZ / binHz));
+
+  let powerSum = 0;
+  let logSum = 0;
+  let count = 0;
+  for (let i = low; i <= high; i += 1) {
+    const power = 10 ** (Math.max(freqDb[i], MIN_DB) / 10);
+    powerSum += power;
+    logSum += Math.log(power);
+    count += 1;
+  }
+  if (count === 0 || powerSum <= 0) return { bandDb: MIN_DB, flatness: 1 };
+
+  const flatness = Math.exp(logSum / count) / (powerSum / count);
+  return { bandDb: 10 * Math.log10(powerSum), flatness };
+}
+
+/**
+ * Strength of the strongest periodicity between 75 and 400 Hz (normalised autocorrelation, 0..1).
+ * Voiced speech scores ~0.5-0.95; broadband noise (fan, wind, rain) scores below ~0.3.
+ */
+export function pitchStrength(samples, sampleRate) {
+  // Decimate by averaging: cheaper, and the crude low-pass removes hiss that would only add noise.
+  const factor = Math.max(1, Math.round(sampleRate / PITCH_ANALYSIS_RATE));
+  const rate = sampleRate / factor;
+  const length = Math.floor(samples.length / factor);
+  if (length < 64) return 0;
+
+  const x = new Float32Array(length);
+  let mean = 0;
+  for (let i = 0; i < length; i += 1) {
+    let acc = 0;
+    for (let k = 0; k < factor; k += 1) acc += samples[i * factor + k];
+    x[i] = acc / factor;
+    mean += x[i];
+  }
+  mean /= length;
+
+  // Prefix sums of energy let us normalise each lag in O(1).
+  const prefix = new Float64Array(length + 1);
+  for (let i = 0; i < length; i += 1) {
+    x[i] -= mean;
+    prefix[i + 1] = prefix[i] + x[i] * x[i];
+  }
+  if (prefix[length] < 1e-10) return 0;
+
+  const minLag = Math.max(2, Math.floor(rate / PITCH_MAX_HZ));
+  const maxLag = Math.min(Math.ceil(rate / PITCH_MIN_HZ), length - 32);
+  let best = 0;
+  for (let lag = minLag; lag <= maxLag; lag += 1) {
+    let cross = 0;
+    for (let i = 0; i < length - lag; i += 1) cross += x[i] * x[i + lag];
+    const energyHead = prefix[length - lag];
+    const energyTail = prefix[length] - prefix[lag];
+    const r = cross / (Math.sqrt(energyHead * energyTail) + 1e-12);
+    if (r > best) best = r;
+  }
+  return clamp01(best);
+}
+
+function percentile(values, fraction) {
+  if (values.length === 0) return 0;
+  const sorted = [...values].sort((a, b) => a - b);
+  return sorted[Math.min(sorted.length - 1, Math.floor(fraction * sorted.length))];
+}
+
+function standardDeviation(values) {
+  if (values.length < 2) return 0;
+  const mean = values.reduce((sum, v) => sum + v, 0) / values.length;
+  return Math.sqrt(values.reduce((sum, v) => sum + (v - mean) ** 2, 0) / values.length);
+}
+
+// ---------------------------------------------------------------------------
+// Detector
+// ---------------------------------------------------------------------------
+
+export class SpeechDetector {
+  constructor(config = {}) {
+    this.config = { ...DEFAULT_DETECTOR_CONFIG, ...config };
+    this.reset();
+  }
+
+  updateConfig(partial) {
+    this.config = { ...this.config, ...partial };
+  }
+
+  reset() {
+    this.elapsed = 0;
+    this.noiseFloorDb = null;
+    this.calibrationSamples = [];
+    this.bandHistory = []; // voice-band level per frame (for modulation)
+    this.scoreHistory = []; // per-frame speech evidence (for the rolling confidence)
+    this.speechSeconds = 0;
+    this.episodeConfidenceSum = 0;
+    this.episodeFrames = 0;
+    this.cooldownUntil = 0;
+  }
+
+  /**
+   * Feed one audio frame.
+   * @param {{timeDomain: Float32Array, freqDb: Float32Array, sampleRate: number, dt: number}} frame
+   *        dt = seconds since the previous frame.
+   * @returns {{confidence:number, frameScore:number, level:number, calibrating:boolean,
+   *            calibrationProgress:number, speaking:boolean, speechSeconds:number,
+   *            event:null|{confidence:number, durationSeconds:number}}}
+   */
+  process({ timeDomain, freqDb, sampleRate, dt }) {
+    const cfg = this.config;
+    const step = Math.min(Math.max(dt, 0), 0.5); // a throttled/stalled tab must not skew the timing
+    this.elapsed += step;
+
+    const levelDb = frameLevelDb(timeDomain);
+    const { bandDb, flatness } = voiceBandStats(freqDb, sampleRate);
+    const calibrating = this.elapsed < cfg.calibrationSeconds;
+
+    // ---- 1. learn / track the background noise floor --------------------------------------
+    if (calibrating) {
+      this.calibrationSamples.push(bandDb);
+    } else if (this.noiseFloorDb === null) {
+      this.noiseFloorDb = percentile(this.calibrationSamples, 0.25);
+    }
+
+    // ---- 2. per-frame evidence of speech --------------------------------------------------
+    this.bandHistory.push(bandDb);
+    const maxHistory = Math.max(4, Math.round(cfg.windowSeconds / Math.max(step, 0.01)));
+    if (this.bandHistory.length > maxHistory) this.bandHistory.shift();
+
+    const floor = this.noiseFloorDb ?? percentile(this.calibrationSamples, 0.25);
+    const aboveFloor = clamp01((bandDb - floor - 3) / 10); // needs >3 dB over the floor, full at 13 dB
+    const pitch = clamp01((pitchStrength(timeDomain, sampleRate) - 0.35) / 0.4);
+    const peaky = clamp01((0.45 - flatness) / 0.35);
+    const modulation = clamp01((standardDeviation(this.bandHistory) - 1.5) / 4.5);
+
+    const evidence = 0.45 * pitch + 0.3 * modulation + 0.25 * peaky;
+    const frameScore = levelDb < -70 ? 0 : aboveFloor * evidence;
+
+    // The floor follows quiet moments quickly, but creeps up slowly and never while speech-like,
+    // so a fan that gets louder is absorbed while a talking candidate does not raise the floor.
+    if (!calibrating && this.noiseFloorDb !== null) {
+      if (bandDb < this.noiseFloorDb) this.noiseFloorDb += (bandDb - this.noiseFloorDb) * 0.2;
+      else if (frameScore < 0.3) this.noiseFloorDb += (bandDb - this.noiseFloorDb) * 0.01;
+    }
+
+    // ---- 3. rolling confidence: "is somebody talking in this window?" -------------------
+    this.scoreHistory.push(frameScore);
+    if (this.scoreHistory.length > maxHistory) this.scoreHistory.shift();
+    const windowFilled = this.scoreHistory.length >= Math.min(maxHistory, 10);
+    // Talking has pauses, so use the 60th percentile rather than the mean: confident if >=40% of
+    // the window is clearly speech-like, regardless of the pauses in between.
+    const confidence = calibrating || !windowFilled ? 0 : percentile(this.scoreHistory, 0.6);
+
+    // ---- 4. sustained-duration accounting --------------------------------------------------
+    const speaking = confidence >= cfg.confidenceThreshold;
+    if (speaking) {
+      this.speechSeconds += step;
+      this.episodeConfidenceSum += confidence;
+      this.episodeFrames += 1;
+    } else {
+      this.speechSeconds = Math.max(0, this.speechSeconds - step * 0.5); // brief pauses are tolerated
+      if (this.speechSeconds === 0) {
+        this.episodeConfidenceSum = 0;
+        this.episodeFrames = 0;
+      }
+    }
+
+    let event = null;
+    if (this.speechSeconds >= cfg.minDurationSeconds && this.elapsed >= this.cooldownUntil) {
+      event = {
+        confidence: this.episodeConfidenceSum / Math.max(1, this.episodeFrames),
+        durationSeconds: this.speechSeconds,
+      };
+      this.cooldownUntil = this.elapsed + cfg.cooldownSeconds;
+      this.speechSeconds = 0;
+      this.episodeConfidenceSum = 0;
+      this.episodeFrames = 0;
+    }
+
+    return {
+      confidence,
+      frameScore,
+      level: clamp01((levelDb + 60) / 50),
+      calibrating,
+      calibrationProgress: clamp01(this.elapsed / cfg.calibrationSeconds),
+      speaking,
+      speechSeconds: this.speechSeconds,
+      event,
+    };
+  }
+}
diff --git a/frontend/src/utils/audioDetector.test.js b/frontend/src/utils/audioDetector.test.js
new file mode 100644
index 0000000..0edf0a1
--- /dev/null
+++ b/frontend/src/utils/audioDetector.test.js
@@ -0,0 +1,283 @@
+/**
+ * Tests for the voice detector. Run with `npm test` (Node's built-in test runner, no extra dependencies).
+ *
+ * Audio is synthesised deterministically: a fan (low-passed noise + mains hum), keyboard clicks,
+ * and a source-filter "talker" (pitched glottal pulses -> vowel formants -> syllable/word envelope).
+ * Frames are produced exactly like the browser's AnalyserNode does: 2048 samples, Blackman window,
+ * |FFT|/N in dB, one frame every 50 ms.
+ */
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+
+import { pitchStrength, SpeechDetector, voiceBandStats } from "./audioDetector.js";
+
+const SR = 48000;
+const FFT_SIZE = 2048;
+const HOP_SECONDS = 0.05;
+
+// ---------------------------------------------------------------- signal helpers
+function rng(seed) {
+  let s = seed >>> 0;
+  return () => (s = (Math.imul(s, 1664525) + 1013904223) >>> 0) / 4294967296;
+}
+function gauss(random) {
+  return Math.sqrt(-2 * Math.log(random() + 1e-12)) * Math.cos(2 * Math.PI * random());
+}
+const rms = (x) => Math.sqrt(x.reduce((sum, v) => sum + v * v, 0) / x.length);
+function scaleTo(x, target) {
+  const gain = target / (rms(x) + 1e-12);
+  return x.map((v) => v * gain);
+}
+function mix(a, b) {
+  const out = new Float32Array(Math.max(a.length, b.length));
+  for (let i = 0; i < out.length; i += 1) out[i] = (a[i] || 0) + (b[i] || 0);
+  return out;
+}
+function concat(...parts) {
+  const out = new Float32Array(parts.reduce((n, p) => n + p.length, 0));
+  let offset = 0;
+  for (const part of parts) {
+    out.set(part, offset);
+    offset += part.length;
+  }
+  return out;
+}
+
+/** Desk fan: low-passed noise + rumble + mains hum, with a slow level drift. */
+function fan(seconds, amplitude, seed = 1) {
+  const random = rng(seed);
+  const out = new Float32Array(Math.round(seconds * SR));
+  let low = 0;
+  let rumble = 0;
+  for (let i = 0; i < out.length; i += 1) {
+    const t = i / SR;
+    low += 0.12 * (gauss(random) - low);
+    rumble += 0.02 * (gauss(random) - rumble);
+    const hum = 0.15 * Math.sin(2 * Math.PI * 100 * t) + 0.08 * Math.sin(2 * Math.PI * 200 * t);
+    out[i] = amplitude * (low + 2.5 * rumble + hum) * (1 + 0.04 * Math.sin(2 * Math.PI * 0.3 * t));
+  }
+  return out;
+}
+
+/** Mouse / keyboard clicks: short decaying noise bursts. */
+function clicks(seconds, perSecond, amplitude, seed = 2) {
+  const random = rng(seed);
+  const out = new Float32Array(Math.round(seconds * SR));
+  for (let k = 0; k < seconds * perSecond; k += 1) {
+    const start = Math.floor(random() * (out.length - 1000));
+    for (let i = 0; i < 0.012 * SR; i += 1) {
+      out[start + i] += amplitude * gauss(random) * Math.exp(-i / (0.003 * SR));
+    }
+  }
+  return out;
+}
+
+/** A talker: pitched, formant-filtered, with ~4.5 Hz syllables and 0.5 s pauses between 1.5 s phrases. */
+function talker(seconds, seed = 3) {
+  const random = rng(seed);
+  const out = new Float32Array(Math.round(seconds * SR));
+  const resonators = [
+    { bandwidth: 90, state: [0, 0] },
+    { bandwidth: 110, state: [0, 0] },
+    { bandwidth: 160, state: [0, 0] },
+  ];
+  let phase = 0;
+  for (let i = 0; i < out.length; i += 1) {
+    const t = i / SR;
+    const f0 = 120 + 25 * Math.sin(2 * Math.PI * 0.7 * t) + 8 * Math.sin(2 * Math.PI * 3.1 * t);
+    phase = (phase + f0 / SR) % 1;
+    const source = (2 * phase - 1) + 0.02 * gauss(random); // sawtooth glottal source + a little breath
+
+    const vowel = Math.floor(t * 4.5) % 3; // a different vowel every syllable
+    const formants = [[700, 1200, 2600], [350, 2200, 2900], [450, 800, 2500]][vowel];
+    let filtered = 0;
+    resonators.forEach((r, index) => {
+      const w = (2 * Math.PI * formants[index]) / SR;
+      const decay = Math.exp((-Math.PI * r.bandwidth) / SR);
+      const y = source + 2 * decay * Math.cos(w) * r.state[0] - decay * decay * r.state[1];
+      r.state = [y, r.state[0]];
+      filtered += (y * (1 - 0.0)) / (index + 1);
+    });
+
+    const syllable = Math.max(0, Math.sin(2 * Math.PI * 4.5 * t)) ** 0.7;
+    const phrase = t % 2 < 1.5 ? 1 : 0;
+    out[i] = filtered * syllable * phrase;
+  }
+  return scaleTo(out, 0.08);
+}
+
+// ---------------------------------------------------------------- browser-like framing
+const blackman = Float64Array.from({ length: FFT_SIZE }, (_, i) => {
+  const a = 0.16;
+  return (1 - a) / 2 - 0.5 * Math.cos((2 * Math.PI * i) / FFT_SIZE) + (a / 2) * Math.cos((4 * Math.PI * i) / FFT_SIZE);
+});
+
+function fftDb(samples) {
+  const n = samples.length;
+  const re = new Float64Array(n);
+  const im = new Float64Array(n);
+  for (let i = 0; i < n; i += 1) re[i] = samples[i] * blackman[i];
+  for (let i = 1, j = 0; i < n; i += 1) {
+    let bit = n >> 1;
+    for (; j & bit; bit >>= 1) j ^= bit;
+    j ^= bit;
+    if (i < j) [re[i], re[j]] = [re[j], re[i]];
+  }
+  for (let len = 2; len <= n; len <<= 1) {
+    const angle = (-2 * Math.PI) / len;
+    const wr = Math.cos(angle);
+    const wi = Math.sin(angle);
+    for (let i = 0; i < n; i += len) {
+      let cr = 1;
+      let ci = 0;
+      for (let k = 0; k < len / 2; k += 1) {
+        const a = i + k;
+        const b = a + len / 2;
+        const vr = re[b] * cr - im[b] * ci;
+        const vi = re[b] * ci + im[b] * cr;
+        re[b] = re[a] - vr;
+        im[b] = im[a] - vi;
+        re[a] += vr;
+        im[a] += vi;
+        const nextCr = cr * wr - ci * wi;
+        ci = cr * wi + ci * wr;
+        cr = nextCr;
+      }
+    }
+  }
+  const out = new Float32Array(n / 2);
+  for (let i = 0; i < n / 2; i += 1) out[i] = 20 * Math.log10(Math.hypot(re[i], im[i]) / n + 1e-12);
+  return out;
+}
+
+function stream(signal, config = {}) {
+  const detector = new SpeechDetector(config);
+  const hop = Math.round(HOP_SECONDS * SR);
+  const frames = [];
+  const events = [];
+  for (let end = FFT_SIZE; end <= signal.length; end += hop) {
+    const timeDomain = signal.subarray(end - FFT_SIZE, end);
+    const result = detector.process({ timeDomain, freqDb: fftDb(timeDomain), sampleRate: SR, dt: HOP_SECONDS });
+    frames.push({ time: end / SR, ...result });
+    if (result.event) events.push({ time: end / SR, ...result.event });
+  }
+  return { frames, events };
+}
+
+const maxConfidence = (frames) => Math.max(...frames.map((f) => f.confidence));
+/** `talk` mixed over a fan that is `snrDb` quieter than the talker. */
+function speechOverFan(snrDb, { lead = 6, talkSeconds = 20, seed = 5 } = {}) {
+  const voice = talker(talkSeconds, seed);
+  const fanAmp = rms(voice) / 10 ** (snrDb / 20) / rms(fan(5, 1, 9));
+  return concat(fan(lead, fanAmp, 10), mix(voice, fan(talkSeconds, fanAmp, 11)));
+}
+
+// ---------------------------------------------------------------- feature functions
+describe("feature extraction", () => {
+  it("scores harmonic (voiced) sound as periodic and broadband noise as not periodic", () => {
+    const voiced = Float32Array.from({ length: FFT_SIZE }, (_, i) => {
+      let sample = 0;
+      for (let harmonic = 1; harmonic <= 12; harmonic += 1) {
+        sample += Math.sin((2 * Math.PI * 130 * harmonic * i) / SR) / harmonic; // 130 Hz voice-like tone
+      }
+      return 0.1 * sample;
+    });
+    const random = rng(99);
+    const noise = Float32Array.from({ length: FFT_SIZE }, () => 0.1 * gauss(random));
+    assert.ok(pitchStrength(voiced, SR) > 0.8, "a harmonic tone should be strongly periodic");
+    assert.ok(pitchStrength(noise, SR) < 0.35, "white noise should not be periodic");
+  });
+
+  it("reports a flatter spectrum for noise than for a harmonic voice", () => {
+    const voiced = talker(1).slice(SR / 4, SR / 4 + FFT_SIZE);
+    const noise = fan(1, 0.05, 4).slice(0, FFT_SIZE);
+    assert.ok(voiceBandStats(fftDb(noise), SR).flatness > voiceBandStats(fftDb(voiced), SR).flatness);
+  });
+});
+
+// ---------------------------------------------------------------- the actual behaviour
+describe("background noise is NOT reported as talking", () => {
+  it("ignores a steady fan, however loud", () => {
+    for (const amplitude of [0.01, 0.04, 0.15]) {
+      const { frames, events } = stream(fan(45, amplitude, 7));
+      assert.equal(events.length, 0, `fan at ${amplitude}`);
+      assert.ok(maxConfidence(frames) < 0.3, `fan at ${amplitude} reached confidence ${maxConfidence(frames)}`);
+    }
+  });
+
+  it("absorbs a fan that suddenly gets 10 dB louder", () => {
+    const { frames, events } = stream(concat(fan(8, 0.02, 12), fan(40, 0.063, 13)));
+    assert.equal(events.length, 0);
+    assert.ok(maxConfidence(frames) < 0.4);
+  });
+
+  it("ignores a fan whose speed keeps changing", () => {
+    const parts = [fan(8, 0.04, 20)];
+    for (let i = 0; i < 6; i += 1) parts.push(fan(10, i % 2 ? 0.04 : 0.16, 21 + i));
+    assert.equal(stream(concat(...parts)).events.length, 0);
+  });
+
+  it("ignores mouse and keyboard clicks", () => {
+    const { events } = stream(concat(fan(8, 0.04, 30), mix(fan(45, 0.04, 31), clicks(45, 6, 0.3))));
+    assert.equal(events.length, 0);
+  });
+
+  it("ignores clicks in an otherwise silent room", () => {
+    const { events } = stream(concat(fan(8, 0.0008, 32), mix(fan(45, 0.0008, 33), clicks(45, 5, 0.2))));
+    assert.equal(events.length, 0);
+  });
+});
+
+describe("talking IS reported", () => {
+  it("flags sustained speech over a fan, with a high confidence, only after the minimum duration", () => {
+    const { events } = stream(speechOverFan(20));
+    assert.ok(events.length >= 1, "speech was not detected");
+
+    const [first] = events;
+    const secondsIntoSpeech = first.time - 6; // speech starts after the 6 s lead-in
+    assert.ok(secondsIntoSpeech >= 4, `reported after only ${secondsIntoSpeech}s of speech`);
+    assert.ok(secondsIntoSpeech <= 10, `took ${secondsIntoSpeech}s to report`);
+    assert.ok(first.confidence >= 0.7 && first.confidence <= 1, `confidence ${first.confidence}`);
+    assert.ok(first.durationSeconds >= 4);
+  });
+
+  it("flags speech in a quiet room", () => {
+    assert.ok(stream(concat(fan(6, 0.0005, 40), talker(20, 41))).events.length >= 1);
+  });
+
+  it("does not report anything while it is still learning the room (calibration)", () => {
+    const { frames, events } = stream(talker(4, 50), { calibrationSeconds: 5 });
+    assert.equal(events.length, 0);
+    assert.ok(frames.every((f) => f.calibrating && f.confidence === 0));
+  });
+
+  it("keeps reporting continuous talking, but no more often than the cooldown allows", () => {
+    const { events } = stream(speechOverFan(20, { talkSeconds: 45 }), { cooldownSeconds: 10 });
+    assert.ok(events.length >= 2 && events.length <= 5, `${events.length} events`);
+    for (let i = 1; i < events.length; i += 1) {
+      assert.ok(events[i].time - events[i - 1].time >= 10, "events closer together than the cooldown");
+    }
+  });
+});
+
+describe("admin settings change the outcome", () => {
+  it("a longer minimum duration suppresses short speech", () => {
+    const signal = speechOverFan(20, { talkSeconds: 12 });
+    assert.ok(stream(signal, { minDurationSeconds: 4 }).events.length >= 1);
+    assert.equal(stream(signal, { minDurationSeconds: 25 }).events.length, 0);
+  });
+
+  it("a higher confidence threshold ignores marginal (quiet / far away) speech", () => {
+    const marginal = speechOverFan(16); // talker only ~16 dB above the fan
+    assert.equal(stream(marginal, { confidenceThreshold: 0.9 }).events.length, 0);
+    assert.ok(stream(marginal, { confidenceThreshold: 0.3 }).events.length >= 1);
+  });
+
+  it("short bursts separated by silence never add up to a violation", () => {
+    const burst = talker(1.2, 60);
+    const gap = fan(3.5, 0.01, 61);
+    const parts = [fan(6, 0.01, 62)];
+    for (let i = 0; i < 8; i += 1) parts.push(mix(burst, fan(1.2, 0.01, 63 + i)), gap);
+    assert.equal(stream(concat(...parts)).events.length, 0);
+  });
+});
diff --git a/frontend/src/utils/audioMonitor.js b/frontend/src/utils/audioMonitor.js
new file mode 100644
index 0000000..9fe1df6
--- /dev/null
+++ b/frontend/src/utils/audioMonitor.js
@@ -0,0 +1,88 @@
+/**
+ * Browser side of voice monitoring: owns the microphone + Web Audio graph and feeds frames to the
+ * pure SpeechDetector. Kept separate so the maths stays unit-testable without a browser.
+ */
+import { SpeechDetector } from "./audioDetector";
+
+const FRAME_INTERVAL_MS = 50;
+
+export class AudioMonitor {
+  /**
+   * @param {{onFrame?: Function, onViolation?: Function, onError?: Function, config?: object}} options
+   */
+  constructor({ onFrame, onViolation, onError, config } = {}) {
+    this.onFrame = onFrame;
+    this.onViolation = onViolation;
+    this.onError = onError;
+    this.detector = new SpeechDetector(config);
+    this.stream = null;
+    this.context = null;
+    this.timer = null;
+  }
+
+  /** Starts capturing. Resolves with the MediaStream (so the caller can check its tracks). */
+  async start() {
+    // Echo cancellation / noise suppression take out much of the fan noise before we even analyse it;
+    // auto-gain is off because it would pump fan noise up to speech level.
+    this.stream = await navigator.mediaDevices.getUserMedia({
+      audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: false },
+    });
+
+    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
+    this.context = new AudioContextClass();
+    if (this.context.state === "suspended") await this.context.resume();
+
+    const source = this.context.createMediaStreamSource(this.stream);
+    this.analyser = this.context.createAnalyser();
+    this.analyser.fftSize = 2048;
+    this.analyser.smoothingTimeConstant = 0; // we do our own temporal smoothing
+    source.connect(this.analyser);
+
+    this.timeDomain = new Float32Array(this.analyser.fftSize);
+    this.freqDb = new Float32Array(this.analyser.frequencyBinCount);
+    this.lastTick = performance.now();
+
+    this.stream.getAudioTracks().forEach((track) => {
+      track.addEventListener("ended", () => this.onError?.(new Error("Microphone disconnected")));
+    });
+
+    this.timer = setInterval(() => this.tick(), FRAME_INTERVAL_MS);
+    return this.stream;
+  }
+
+  tick() {
+    if (!this.analyser) return;
+    const now = performance.now();
+    const dt = (now - this.lastTick) / 1000;
+    this.lastTick = now;
+
+    // Browsers suspend audio contexts in background tabs; try to wake it back up.
+    if (this.context.state === "suspended") this.context.resume().catch(() => {});
+
+    this.analyser.getFloatTimeDomainData(this.timeDomain);
+    this.analyser.getFloatFrequencyData(this.freqDb);
+    const result = this.detector.process({
+      timeDomain: this.timeDomain,
+      freqDb: this.freqDb,
+      sampleRate: this.context.sampleRate,
+      dt,
+    });
+    this.onFrame?.(result);
+    if (result.event) this.onViolation?.(result.event);
+  }
+
+  /** Apply the exam's current thresholds (they can change while the exam is running). */
+  updateConfig(config) {
+    this.detector.updateConfig(config);
+  }
+
+  stop() {
+    clearInterval(this.timer);
+    this.timer = null;
+    this.stream?.getTracks().forEach((track) => track.stop());
+    this.stream = null;
+    this.analyser = null;
+    if (this.context && this.context.state !== "closed") this.context.close().catch(() => {});
+    this.context = null;
+  }
+}
