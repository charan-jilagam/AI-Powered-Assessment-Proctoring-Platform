+"""Tests for the vision helpers. The AI models are replaced with stubs, so no model files are needed."""
+from types import SimpleNamespace
+
+import pytest
+
+from app import proctoring
+from app.proctoring import PROHIBITED_OBJECTS, analyze_frame, compute_gaze, compute_mouth_openness
+
+
+def make_landmarks(iris_x=0.35, right_iris_x=0.65, upper_lip_y=0.60, lower_lip_y=0.61):
+    """478 neutral points with the handful of landmarks the analyser reads positioned explicitly."""
+    points = [SimpleNamespace(x=0.5, y=0.5) for _ in range(478)]
+    points[33], points[133] = SimpleNamespace(x=0.30, y=0.4), SimpleNamespace(x=0.40, y=0.4)   # left eye corners
+    points[362], points[263] = SimpleNamespace(x=0.60, y=0.4), SimpleNamespace(x=0.70, y=0.4)  # right eye corners
+    for index in (474, 475, 476, 477):
+        points[index] = SimpleNamespace(x=iris_x, y=0.4)
+    for index in (469, 470, 471, 472):
+        points[index] = SimpleNamespace(x=right_iris_x, y=0.4)
+    points[10], points[152] = SimpleNamespace(x=0.5, y=0.2), SimpleNamespace(x=0.5, y=0.8)       # forehead / chin
+    points[13], points[14] = SimpleNamespace(x=0.5, y=upper_lip_y), SimpleNamespace(x=0.5, y=lower_lip_y)
+    return points
+
+
+# ---------------- gaze ----------------
+
+def test_centered_gaze_is_not_flagged():
+    direction, ratio, confidence = compute_gaze(make_landmarks())
+    assert direction == "center" and ratio == pytest.approx(0.5, abs=0.01) and confidence == 0.0
+
+
+def test_gaze_left_and_right_are_detected_with_confidence():
+    direction, _, left_confidence = compute_gaze(make_landmarks(iris_x=0.31, right_iris_x=0.61))
+    assert direction == "left" and 0.5 <= left_confidence <= 1.0
+    direction, _, _ = compute_gaze(make_landmarks(iris_x=0.39, right_iris_x=0.69))
+    assert direction == "right"
+
+
+def test_a_stronger_glance_has_higher_confidence():
+    _, _, mild = compute_gaze(make_landmarks(iris_x=0.34, right_iris_x=0.64))   # ratio 0.4 (inside limit)
+    _, _, edge = compute_gaze(make_landmarks(iris_x=0.3349, right_iris_x=0.6349))
+    _, _, strong = compute_gaze(make_landmarks(iris_x=0.30, right_iris_x=0.60))
+    assert mild == 0.0
+    assert edge < strong
+
+
+# ---------------- mouth ----------------
+
+def test_mouth_openness_is_normalised_by_face_height():
+    closed = compute_mouth_openness(make_landmarks(lower_lip_y=0.605))
+    open_mouth = compute_mouth_openness(make_landmarks(lower_lip_y=0.68))
+    assert closed < 0.02 < 0.1 < open_mouth
+
+
+# ---------------- object list ----------------
+
+def test_keyboard_and_mouse_are_not_prohibited():
+    assert "keyboard" not in PROHIBITED_OBJECTS and "mouse" not in PROHIBITED_OBJECTS
+    assert "cell phone" in PROHIBITED_OBJECTS
+
+
+class _Box:
+    def __init__(self, class_id, confidence):
+        self.cls, self.conf = [class_id], [confidence]
+
+
+class _FakeYolo:
+    names = {0: "person", 1: "cell phone", 2: "keyboard", 3: "book"}
+
+    def __init__(self, boxes):
+        self._boxes = boxes
+        self.last_kwargs = None
+
+    def __call__(self, img, **kwargs):
+        self.last_kwargs = kwargs
+        return [SimpleNamespace(boxes=self._boxes)]
+
+
+def test_object_detection_filters_to_prohibited_classes_and_best_confidence(monkeypatch):
+    fake = _FakeYolo([_Box(1, 0.55), _Box(1, 0.82), _Box(2, 0.95), _Box(0, 0.99), _Box(3, 0.30)])
+    monkeypatch.setattr(proctoring, "get_yolo", lambda: fake)
+
+    found = proctoring.detect_objects(object(), min_confidence=0.5)
+
+    assert found == {"cell phone": 0.82}  # keyboard/person ignored, low-confidence book dropped, best phone kept
+    assert fake.last_kwargs["conf"] == 0.5
+
+
+# ---------------- analyze_frame ----------------
+
+@pytest.fixture
+def stub_pipeline(monkeypatch):
+    state = {"faces": [make_landmarks()], "objects": {}}
+    monkeypatch.setattr(proctoring, "decode_image", lambda _: object())
+    monkeypatch.setattr(proctoring, "detect_faces", lambda _: state["faces"])
+    monkeypatch.setattr(proctoring, "detect_objects", lambda _img, _conf: state["objects"])
+    return state
+
+
+def codes(result):
+    return {s.code for s in result["signals"]}
+
+
+def test_clean_frame_has_no_signals(stub_pipeline):
+    result = analyze_frame("img", key="clean")
+    assert result["face_detected"] and result["face_count"] == 1
+    assert result["signals"] == [] and result["gaze_direction"] == "center"
+
+
+def test_missing_face_is_a_serious_signal(stub_pipeline):
+    stub_pipeline["faces"] = []
+    result = analyze_frame("img", key="noface")
+    assert codes(result) == {"no_face"}
+    assert result["signals"][0].level == 2
+
+
+def test_second_person_is_flagged(stub_pipeline):
+    stub_pipeline["faces"] = [make_landmarks(), make_landmarks()]
+    result = analyze_frame("img", key="two")
+    assert "multiple_faces" in codes(result) and result["face_count"] == 2
+
+
+def test_looking_away_is_a_minor_signal_with_direction_detail(stub_pipeline):
+    stub_pipeline["faces"] = [make_landmarks(iris_x=0.30, right_iris_x=0.60)]
+    signal = analyze_frame("img", key="gaze")["signals"][0]
+    assert signal.code == "looking_away" and signal.level == 1 and signal.detail == "direction=left"
+
+
+def test_prohibited_object_becomes_a_serious_signal_with_its_confidence(stub_pipeline):
+    stub_pipeline["objects"] = {"cell phone": 0.77}
+    signal = analyze_frame("img", key="phone")["signals"][0]
+    assert (signal.code, signal.level, signal.confidence) == ("object_cell_phone", 2, 0.77)
+
+
+def test_objects_are_still_checked_when_no_face_is_visible(stub_pipeline):
+    stub_pipeline["faces"] = []
+    stub_pipeline["objects"] = {"cell phone": 0.9}
+    assert codes(analyze_frame("img", key="cover")) == {"no_face", "object_cell_phone"}
+
+
+def test_talking_is_detected_from_mouth_movement_across_frames(stub_pipeline):
+    openings = [0.605, 0.69, 0.61, 0.70, 0.605, 0.68, 0.612, 0.70]
+    seen = set()
+    for lower in openings:
+        stub_pipeline["faces"] = [make_landmarks(lower_lip_y=lower)]
+        seen |= codes(analyze_frame("img", key="talker"))
+    assert "lip_movement" in seen
+
+
+def test_a_mouth_held_open_is_not_talking(stub_pipeline):
+    stub_pipeline["faces"] = [make_landmarks(lower_lip_y=0.70)]
+    seen = set()
+    for _ in range(10):
+        seen |= codes(analyze_frame("img", key="yawn"))
+    assert "lip_movement" not in seen
+
+
+def test_undecodable_image_is_reported_not_raised(monkeypatch):
+    monkeypatch.setattr(proctoring, "decode_image", lambda _: None)
+    result = analyze_frame("garbage")
+    assert result["signals"] == [] and result["warnings"] == ["Could not process image"]
+
+
+def test_a_failing_face_model_does_not_stop_object_detection(monkeypatch):
+    monkeypatch.setattr(proctoring, "decode_image", lambda _: object())
+
+    def broken(_):
+        raise RuntimeError("landmarker missing")
+
+    monkeypatch.setattr(proctoring, "detect_faces", broken)
+    monkeypatch.setattr(proctoring, "detect_objects", lambda _img, _conf: {"book": 0.8})
+    assert codes(analyze_frame("img", key="resilient")) == {"object_book"}
