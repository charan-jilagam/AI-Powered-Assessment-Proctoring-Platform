@@ -0,0 +1,93 @@
+"""The start-up migration must upgrade a database created by an older version of the app."""
+from sqlalchemy import create_engine, inspect, text
+from sqlalchemy.orm import sessionmaker
+
+from app import models
+from app.migrations import ensure_schema
+from app.policy import ProctorPolicy
+
+LEGACY_SCHEMA = [
+    """CREATE TABLE users (id INTEGER PRIMARY KEY, full_name VARCHAR NOT NULL, email VARCHAR NOT NULL UNIQUE,
+       hashed_password VARCHAR NOT NULL, role VARCHAR, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)""",
+    """CREATE TABLE exams (id INTEGER PRIMARY KEY, title VARCHAR NOT NULL, description TEXT,
+       duration_minutes INTEGER NOT NULL, start_time DATETIME NOT NULL, end_time DATETIME NOT NULL,
+       created_by INTEGER, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)""",
+    """CREATE TABLE questions (id INTEGER PRIMARY KEY, exam_id INTEGER NOT NULL, question_text TEXT NOT NULL,
+       option_a VARCHAR NOT NULL, option_b VARCHAR NOT NULL, option_c VARCHAR NOT NULL, option_d VARCHAR NOT NULL,
+       correct_answer VARCHAR NOT NULL)""",
+    """CREATE TABLE submissions (id INTEGER PRIMARY KEY, exam_id INTEGER NOT NULL, student_id INTEGER NOT NULL,
+       answers TEXT NOT NULL, score INTEGER NOT NULL, total_questions INTEGER NOT NULL,
+       submitted_at DATETIME DEFAULT CURRENT_TIMESTAMP)""",
+    """CREATE TABLE violations (id INTEGER PRIMARY KEY, exam_id INTEGER NOT NULL, student_id INTEGER NOT NULL,
+       violation_type VARCHAR NOT NULL, details TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP)""",
+    """CREATE TABLE exam_sessions (id INTEGER PRIMARY KEY, exam_id INTEGER NOT NULL, student_id INTEGER NOT NULL,
+       question_data TEXT NOT NULL, started_at DATETIME DEFAULT CURRENT_TIMESTAMP, status VARCHAR)""",
+]
+
+
+def _legacy_engine(tmp_path):
+    engine = create_engine(f"sqlite:///{tmp_path / 'legacy.db'}")
+    with engine.begin() as connection:
+        for statement in LEGACY_SCHEMA:
+            connection.execute(text(statement))
+        connection.execute(text(
+            "INSERT INTO exams (id, title, duration_minutes, start_time, end_time) "
+            "VALUES (1, 'Old exam', 30, '2026-01-01', '2027-01-01')"
+        ))
+        connection.execute(text(
+            "INSERT INTO exam_sessions (id, exam_id, student_id, question_data, status) "
+            "VALUES (1, 1, 7, '[]', 'in_progress')"
+        ))
+        for violation_type in ["Tab switch detected", "Attempted right-click",
+                               "AI: Voice/talking detected", "AI: Mobile phone detected",
+                               "AI: Eyes looking away (left)"]:
+            connection.execute(
+                text("INSERT INTO violations (exam_id, student_id, violation_type) VALUES (1, 7, :t)"),
+                {"t": violation_type},
+            )
+    return engine
+
+
+def test_missing_columns_are_added_with_sensible_defaults(tmp_path):
+    engine = _legacy_engine(tmp_path)
+    added = ensure_schema(engine)
+
+    assert "exams.max_violations" in added
+    assert "exams.audio_confidence_threshold" in added
+    assert "violations.level" in added
+    assert "exam_sessions.terminated_reason" in added
+
+    columns = {c["name"] for c in inspect(engine).get_columns("exams")}
+    assert {"max_violations", "audio_monitoring_enabled", "audio_min_duration_seconds"} <= columns
+
+    # The ORM can read the upgraded rows and they inherit the default policy.
+    with sessionmaker(bind=engine)() as db:
+        exam = db.get(models.Exam, 1)
+        policy = ProctorPolicy.from_exam(exam)
+        assert policy.max_violations == 5
+        assert policy.audio_monitoring_enabled is True
+        assert policy.audio_confidence_threshold == 0.7
+
+
+def test_legacy_violations_are_backfilled_with_level_and_source(tmp_path):
+    engine = _legacy_engine(tmp_path)
+    ensure_schema(engine)
+
+    with engine.connect() as connection:
+        rows = {
+            violation_type: (level, source)
+            for violation_type, level, source in connection.execute(
+                text("SELECT violation_type, level, source FROM violations")
+            )
+        }
+    assert rows["Tab switch detected"] == (2, "browser")
+    assert rows["Attempted right-click"] == (1, "browser")
+    assert rows["AI: Voice/talking detected"] == (1, "audio")
+    assert rows["AI: Mobile phone detected"] == (2, "vision")
+    assert rows["AI: Eyes looking away (left)"] == (1, "vision")
+
+
+def test_migration_is_idempotent(tmp_path):
+    engine = _legacy_engine(tmp_path)
+    assert ensure_schema(engine)
+    assert ensure_schema(engine) == []
