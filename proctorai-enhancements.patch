+import Icon from "./Icon";
+import { Brand } from "./AppShell";
+
+const POINTS = [
+  { icon: "eye", title: "Camera checks that wait for proof", text: "A glance away is not a strike. Signals must persist before they count." },
+  { icon: "mic", title: "Voice detection that ignores fans", text: "Background noise is learned and filtered; only sustained speech is flagged." },
+  { icon: "lock", title: "A limit you control", text: "Admins set how many violations end an exam, per exam, even while it is running." },
+];
+
+export default function AuthAside() {
+  return (
+    <aside className="auth-aside">
+      <Brand />
+      <div>
+        <h1>Fair exams, proctored with restraint</h1>
+        <p>Every flag comes with a confidence score and a reason, so results can be reviewed, not just trusted.</p>
+        <ul className="auth-list">
+          {POINTS.map((point) => (
+            <li key={point.title}>
+              <span className="ico"><Icon name={point.icon} /></span>
+              <div>
+                <strong>{point.title}</strong>
+                <span>{point.text}</span>
+              </div>
+            </li>
+          ))}
+        </ul>
+      </div>
+      <span className="small faint">ProctorAI</span>
+    </aside>
+  );
+}
