@@ -0,0 +1,158 @@
+"""Unit tests for the proctoring policy rules (pure Python, no database or AI models)."""
+from datetime import datetime, timedelta, timezone
+from types import SimpleNamespace
+
+from app.policy import (
+    DEFAULT_SETTINGS,
+    LipMotionTracker,
+    ProctorPolicy,
+    Signal,
+    SignalTracker,
+    audio_gate,
+    classify_level,
+    confirm_signals,
+    infer_source,
+    seconds_since,
+)
+
+
+# ---------------- policy construction ----------------
+
+def test_policy_defaults_match_documented_values():
+    policy = ProctorPolicy()
+    assert policy.max_violations == 5
+    assert policy.audio_confidence_threshold == 0.70
+    assert policy.audio_min_duration_seconds == 4.0
+
+
+def test_policy_from_exam_falls_back_to_defaults_for_missing_values():
+    exam = SimpleNamespace(max_violations=None, audio_confidence_threshold=0.9)  # other attrs absent
+    policy = ProctorPolicy.from_exam(exam)
+    assert policy.max_violations == DEFAULT_SETTINGS["max_violations"]
+    assert policy.audio_confidence_threshold == 0.9
+
+
+def test_minor_violations_can_be_excluded_from_the_limit():
+    assert ProctorPolicy(count_minor_violations=True).counts_toward_limit(1)
+    assert not ProctorPolicy(count_minor_violations=False).counts_toward_limit(1)
+    assert ProctorPolicy(count_minor_violations=False).counts_toward_limit(2)
+
+
+# ---------------- classification ----------------
+
+def test_browser_events_are_classified():
+    assert classify_level("Attempted right-click") == 1
+    assert classify_level("Attempted copy/paste/cut") == 1
+    assert classify_level("Keyboard shortcut attempted") == 1
+    assert classify_level("Tab switch detected") == 2
+    assert classify_level("Exited fullscreen mode") == 2
+
+
+def test_source_inference():
+    assert infer_source("AI: Voice/talking detected") == "audio"
+    assert infer_source("AI: Mobile phone detected") == "vision"
+    assert infer_source("Tab switch detected") == "browser"
+
+
+def test_legacy_ai_rows_keep_their_old_levels():
+    assert classify_level("AI: No face detected") == 2
+    assert classify_level("AI: Mobile phone detected") == 2
+    assert classify_level("AI: Eyes looking away (left)") == 1
+    assert classify_level("AI: Lip movement detected - possible speaking") == 1
+
+
+def test_audio_level_depends_on_confidence():
+    assert classify_level("AI: Voice/talking detected", "audio", 0.72) == 1
+    assert classify_level("AI: Voice/talking detected", "audio", 0.90) == 2
+    assert classify_level("AI: Voice/talking detected", "audio", None) == 1
+
+
+# ---------------- audio gate ----------------
+
+def test_audio_gate_rejects_low_confidence_and_disabled_monitoring():
+    policy = ProctorPolicy(audio_confidence_threshold=0.7)
+    assert audio_gate(policy, 0.69) == "below_confidence_threshold"
+    assert audio_gate(policy, None) == "below_confidence_threshold"
+    assert audio_gate(policy, 0.70) is None
+    assert audio_gate(ProctorPolicy(audio_monitoring_enabled=False), 0.99) == "audio_disabled"
+
+
+# ---------------- time helper ----------------
+
+def test_seconds_since_handles_naive_and_aware_datetimes():
+    now = datetime.now(timezone.utc)
+    aware = now - timedelta(seconds=30)
+    naive = aware.replace(tzinfo=None)  # what SQLite hands back
+    assert 29 < seconds_since(aware, now) < 31
+    assert 29 < seconds_since(naive, now) < 31
+
+
+# ---------------- sustained-frame confirmation ----------------
+
+def _no_face():
+    return Signal("no_face", "No face detected", 2, 1.0)
+
+
+def test_signal_must_persist_for_n_frames():
+    tracker, policy = SignalTracker(), ProctorPolicy(sustained_frames=3)
+    outcomes = []
+    for _ in range(4):
+        streaks = tracker.update("s", ["no_face"])
+        outcomes.append(bool(confirm_signals([_no_face()], streaks, policy)))
+    assert outcomes == [False, False, True, True]
+
+
+def test_single_missed_frame_does_not_reset_the_streak():
+    tracker, policy = SignalTracker(), ProctorPolicy(sustained_frames=3)
+    tracker.update("s", ["no_face"])
+    tracker.update("s", ["no_face"])
+    tracker.update("s", [])  # detector blinked for one frame -> streak decays 2 -> 1
+    streaks = tracker.update("s", ["no_face"])  # -> 2
+    assert not confirm_signals([_no_face()], streaks, policy)
+    streaks = tracker.update("s", ["no_face"])  # -> 3
+    assert confirm_signals([_no_face()], streaks, policy)
+
+
+def test_streaks_are_tracked_per_candidate():
+    tracker = SignalTracker()
+    tracker.update("alice", ["no_face"])
+    tracker.update("alice", ["no_face"])
+    assert tracker.update("bob", ["no_face"]) == {"no_face": 1}
+
+
+def test_idle_candidates_are_forgotten():
+    now = [0.0]
+    tracker = SignalTracker(ttl_seconds=60, clock=lambda: now[0])
+    tracker.update("alice", ["no_face"])
+    now[0] = 120.0
+    assert tracker.update("alice", ["no_face"]) == {"no_face": 1}  # old streak expired
+
+
+def test_object_below_confidence_threshold_never_confirms():
+    policy = ProctorPolicy(sustained_frames=1, object_confidence_threshold=0.6)
+    weak = Signal("object_cell_phone", "Mobile phone detected", 2, 0.55)
+    strong = Signal("object_cell_phone", "Mobile phone detected", 2, 0.80)
+    assert confirm_signals([weak], {"object_cell_phone": 5}, policy) == []
+    assert confirm_signals([strong], {"object_cell_phone": 5}, policy) == [strong]
+
+
+# ---------------- lip motion ----------------
+
+def test_mouth_held_open_is_not_talking():
+    tracker = LipMotionTracker()
+    results = [tracker.update("s", 0.08) for _ in range(10)]  # yawning / mouth-breathing
+    assert not any(moving for moving, _ in results)
+
+
+def test_closed_mouth_is_not_talking():
+    tracker = LipMotionTracker()
+    assert not any(tracker.update("s", 0.004)[0] for _ in range(10))
+
+
+def test_fluctuating_mouth_is_talking_with_a_confidence():
+    tracker = LipMotionTracker()
+    moving, confidence = False, 0.0
+    for value in [0.005, 0.07, 0.01, 0.09, 0.006, 0.06, 0.012, 0.08]:
+        moving, confidence = tracker.update("s", value)
+    assert moving
+    assert 0.5 <= confidence <= 1.0
