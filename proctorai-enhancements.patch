+// Mirrors backend/app/policy.py. The server clamps and re-validates every value, so this is for UX only.
+export const DEFAULT_POLICY = {
+  max_violations: 5,
+  count_minor_violations: true,
+  ai_cooldown_seconds: 30,
+  sustained_frames: 3,
+  object_confidence_threshold: 0.5,
+  audio_monitoring_enabled: true,
+  audio_confidence_threshold: 0.7,
+  audio_min_duration_seconds: 4,
+};
+
+export const POLICY_PRESETS = [
+  {
+    id: "lenient",
+    name: "Lenient",
+    blurb: "Practice tests and open-book quizzes",
+    values: {
+      max_violations: 8, count_minor_violations: false, ai_cooldown_seconds: 45, sustained_frames: 4,
+      object_confidence_threshold: 0.6, audio_monitoring_enabled: true,
+      audio_confidence_threshold: 0.8, audio_min_duration_seconds: 6,
+    },
+  },
+  { id: "balanced", name: "Balanced", blurb: "Recommended for most assessments", values: DEFAULT_POLICY },
+  {
+    id: "strict",
+    name: "Strict",
+    blurb: "High-stakes, closed-book exams",
+    values: {
+      max_violations: 3, count_minor_violations: true, ai_cooldown_seconds: 15, sustained_frames: 2,
+      object_confidence_threshold: 0.4, audio_monitoring_enabled: true,
+      audio_confidence_threshold: 0.55, audio_min_duration_seconds: 3,
+    },
+  },
+];
+
+export function matchingPreset(policy) {
+  const found = POLICY_PRESETS.find((preset) =>
+    Object.keys(DEFAULT_POLICY).every((key) => preset.values[key] === policy[key]),
+  );
+  return found ? found.id : "custom";
+}
+
+export function policyIsValid(policy) {
+  return (
+    policy.max_violations >= 1 && policy.max_violations <= 50 &&
+    policy.ai_cooldown_seconds >= 0 && policy.ai_cooldown_seconds <= 600 &&
+    policy.sustained_frames >= 1 && policy.sustained_frames <= 10 &&
+    policy.object_confidence_threshold >= 0.25 && policy.object_confidence_threshold <= 0.95 &&
+    policy.audio_confidence_threshold >= 0.3 && policy.audio_confidence_threshold <= 0.95 &&
+    policy.audio_min_duration_seconds >= 1 && policy.audio_min_duration_seconds <= 30
+  );
+}
+
+export function describeLimit(policy) {
+  const n = policy.max_violations;
+  return `${n} violation${n === 1 ? "" : "s"}${policy.count_minor_violations ? "" : " (serious only)"}`;
+}
