+class LipMotionTracker:
+    """
+    A mouth that is merely *open* (yawning, breathing, concentrating) is not talking.
+    Talking makes the mouth opening fluctuate, so we look at the spread of the normalised
+    mouth opening over the last few frames instead of a single reading.
+    """
+
+    def __init__(self, window: int = 8, min_samples: int = 5, std_threshold: float = 0.012,
+                 min_peak: float = 0.03, ttl_seconds: float = 300,
+                 clock: Callable[[], float] = time.monotonic):
+        self._window = window
+        self._min_samples = min_samples
+        self._std_threshold = std_threshold
+        self._min_peak = min_peak
+        self._store = _TtlStore(ttl_seconds, clock)
+
+    def update(self, key: Hashable, openness: float) -> tuple[bool, float]:
+        """Record one mouth-opening sample. Returns (is_talking, confidence 0..1)."""
+
+        def step(history: deque) -> tuple[bool, float]:
+            history.append(openness)
+            if len(history) < self._min_samples:
+                return False, 0.0
+            spread = pstdev(history)
+            if spread < self._std_threshold or max(history) < self._min_peak:
+                return False, 0.0
+            confidence = 0.5 + (spread - self._std_threshold) / (2 * self._std_threshold)
+            return True, max(0.0, min(1.0, confidence))
+
+        return self._store.with_value(key, lambda: deque(maxlen=self._window), step)
+
+    def reset(self, key: Hashable) -> None:
+        self._store.reset(key)
