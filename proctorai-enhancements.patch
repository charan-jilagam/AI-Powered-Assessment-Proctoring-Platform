--- /dev/null
+++ b/frontend/src/hooks/useAsync.js
@@ -0,0 +1,25 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+
+/** Runs an async loader on mount (and on `reload`), tracking loading / error state safely. */
+export function useAsync(loader, deps = []) {
+  const [state, setState] = useState({ data: null, error: "", loading: true });
+  const loaderRef = useRef(loader);
+  loaderRef.current = loader;
+  const requestId = useRef(0);
+
+  const reload = useCallback(async () => {
+    const id = ++requestId.current;
+    setState((s) => ({ ...s, loading: true, error: "" }));
+    try {
+      const data = await loaderRef.current();
+      if (id === requestId.current) setState({ data, error: "", loading: false });
+    } catch (err) {
+      if (id === requestId.current) setState({ data: null, error: err.message, loading: false });
+    }
+  }, []);
+
+  // eslint-disable-next-line react-hooks/exhaustive-deps
+  useEffect(() => { reload(); }, deps);
+
+  return { ...state, reload };
+}
