+"""End-to-end tests for the admin-configurable violation limit, audio confidence gating and termination."""
+from datetime import datetime, timedelta, timezone
+
+import pytest
+
+from app import main
+from app.policy import Signal
+
+# Five different browser events (identical events within 3 s are de-duplicated).
+FIVE_EVENTS = [
+    "Tab switch detected",
+    "Exited fullscreen mode",
+    "Attempted copy/paste/cut",
+    "Attempted right-click",
+    "Keyboard shortcut attempted",
+]
+
+
+# ---------------- the violation limit ----------------
+
+def test_exam_is_terminated_when_the_default_limit_of_five_is_reached(api, admin, student):
+    exam_id = api.make_exam(admin)
+    api.start_exam(exam_id, student)
+
+    for index, event in enumerate(FIVE_EVENTS, start=1):
+        ack = api.report(exam_id, student, event).json()
+        assert ack["logged"] is True
+        assert ack["violation_count"] == index
+        assert ack["max_violations"] == 5
+        assert ack["terminated"] is (index == 5)
+
+    assert ack["remaining"] == 0
+
+    # Re-entering and submitting are both refused once terminated
+    assert api.client.get(f"/exams/{exam_id}", headers=student).status_code == 403
+    assert api.client.post(f"/exams/{exam_id}/submit", json={"answers": {}}, headers=student).status_code == 403
+    # ...and further reports are acknowledged but not recorded
+    late = api.report(exam_id, student, "Tab switch detected").json()
+    assert late["logged"] is False and late["terminated"] is True
+
+
+def test_limit_is_configurable_per_exam(api, admin, student):
+    exam_id = api.make_exam(admin, max_violations=2)
+    api.start_exam(exam_id, student)
+    assert api.report(exam_id, student, FIVE_EVENTS[0]).json()["terminated"] is False
+    assert api.report(exam_id, student, FIVE_EVENTS[1]).json()["terminated"] is True
+
+
+def test_identical_browser_events_are_deduplicated(api, admin, student):
+    exam_id = api.make_exam(admin)
+    api.start_exam(exam_id, student)
+    first = api.report(exam_id, student, "Tab switch detected").json()
+    second = api.report(exam_id, student, "Tab switch detected").json()
+    assert first["logged"] is True
+    assert second["logged"] is False and second["reason"] == "cooldown"
+    assert second["violation_count"] == 1
+
+
+def test_minor_violations_can_be_excluded_from_the_limit(api, admin, student):
+    exam_id = api.make_exam(admin, max_violations=2, count_minor_violations=False)
+    api.start_exam(exam_id, student)
+
+    for event in ["Attempted copy/paste/cut", "Attempted right-click", "Keyboard shortcut attempted"]:
+        ack = api.report(exam_id, student, event).json()
+        assert ack["logged"] is True  # still recorded for the admin...
+        assert ack["violation_count"] == 0  # ...but not counted
+        assert ack["terminated"] is False
+
+    assert api.report(exam_id, student, "Tab switch detected").json()["terminated"] is False
+    assert api.report(exam_id, student, "Exited fullscreen mode").json()["terminated"] is True
+
+
+def test_lowering_the_limit_mid_exam_takes_effect_immediately(api, admin, student):
+    exam_id = api.make_exam(admin)  # limit 5
+    api.start_exam(exam_id, student)
+    api.report(exam_id, student, FIVE_EVENTS[0])
+    api.report(exam_id, student, FIVE_EVENTS[1])
+
+    response = api.client.put(
+        f"/exams/{exam_id}/settings", json={"max_violations": 3}, headers=admin
+    )
+    assert response.status_code == 200
+
+    ack = api.report(exam_id, student, FIVE_EVENTS[2]).json()
+    assert ack["max_violations"] == 3
+    assert ack["terminated"] is True
+
+
+def test_clients_cannot_report_ai_violations_as_browser_events(api, admin, student):
+    exam_id = api.make_exam(admin)
+    api.start_exam(exam_id, student)
+    assert api.report(exam_id, student, "AI: Mobile phone detected").status_code == 400
+
+
+def test_reporting_without_a_session_is_rejected(api, admin, student):
+    exam_id = api.make_exam(admin)
+    assert api.report(exam_id, student, "Tab switch detected").status_code == 409
+
+
+# ---------------- audio confidence ----------------
+
+def test_voice_below_the_confidence_threshold_is_ignored(api, admin, student):
+    """e.g. a fan or air-conditioner that the browser scored as only 'maybe speech'."""
+    exam_id = api.make_exam(admin, audio_confidence_threshold=0.75)
+    api.start_exam(exam_id, student)
+
+    ack = api.report(exam_id, student, "voice", source="audio", confidence=0.55).json()
+    assert ack["logged"] is False
+    assert ack["reason"] == "below_confidence_threshold"
+    assert ack["violation_count"] == 0
+
+
+def test_voice_above_the_threshold_is_recorded_with_its_confidence(api, admin, student):
+    exam_id = api.make_exam(admin, audio_confidence_threshold=0.75)
+    api.start_exam(exam_id, student)
+
+    ack = api.report(exam_id, student, "voice", source="audio", confidence=0.80).json()
+    assert ack["logged"] is True
+    assert ack["violation_type"] == "AI: Voice/talking detected"
+    assert ack["level"] == 1  # confident, but not very-high-confidence
+
+    rows = api.client.get(f"/exams/{exam_id}/violations", headers=admin).json()
+    assert rows[0]["source"] == "audio"
+    assert rows[0]["confidence"] == pytest.approx(0.80)
+    assert rows[0]["student_name"] == "Student"
+
+
+def test_very_confident_voice_is_a_serious_violation(api, admin, student):
+    exam_id = api.make_exam(admin)
+    api.start_exam(exam_id, student)
+    ack = api.report(exam_id, student, "voice", source="audio", confidence=0.93).json()
+    assert ack["logged"] is True and ack["level"] == 2
+
+
+def test_voice_without_a_confidence_score_is_ignored(api, admin, student):
+    exam_id = api.make_exam(admin)
+    api.start_exam(exam_id, student)
+    assert api.report(exam_id, student, "voice", source="audio").json()["logged"] is False
+
+
+def test_voice_is_ignored_when_audio_monitoring_is_disabled(api, admin, student):
+    exam_id = api.make_exam(admin, audio_monitoring_enabled=False)
+    api.start_exam(exam_id, student)
+    ack = api.report(exam_id, student, "voice", source="audio", confidence=0.99).json()
+    assert ack["logged"] is False and ack["reason"] == "audio_disabled"
+
+
+def test_repeated_voice_detections_respect_the_cooldown(api, admin, student):
+    exam_id = api.make_exam(admin, ai_cooldown_seconds=60)
+    api.start_exam(exam_id, student)
+    assert api.report(exam_id, student, "voice", source="audio", confidence=0.9).json()["logged"] is True
+    again = api.report(exam_id, student, "voice", source="audio", confidence=0.9).json()
+    assert again["logged"] is False and again["reason"] == "cooldown"
+
+
+# ---------------- settings API ----------------
+
+def test_admin_can_read_and_update_settings(api, admin):
+    exam_id = api.make_exam(admin)
+    current = api.client.get(f"/exams/{exam_id}/settings", headers=admin).json()
+    assert current["max_violations"] == 5
+    assert current["audio_confidence_threshold"] == 0.7
+
+    updated = {**current, "max_violations": 8, "audio_confidence_threshold": 0.85, "sustained_frames": 5}
+    assert api.client.put(f"/exams/{exam_id}/settings", json=updated, headers=admin).status_code == 200
+    assert api.client.get(f"/exams/{exam_id}/settings", headers=admin).json() == updated
+
+
+def test_students_cannot_touch_settings(api, admin, student):
+    exam_id = api.make_exam(admin)
+    assert api.client.get(f"/exams/{exam_id}/settings", headers=student).status_code == 403
+    assert api.client.put(f"/exams/{exam_id}/settings", json={}, headers=student).status_code == 403
+
+
+@pytest.mark.parametrize("field,value", [
+    ("max_violations", 0),
+    ("max_violations", 51),
+    ("audio_confidence_threshold", 0.1),
+    ("audio_confidence_threshold", 1.0),
+    ("audio_min_duration_seconds", 0.2),
+    ("sustained_frames", 0),
+    ("object_confidence_threshold", 0.99),
+])
+def test_out_of_range_settings_are_rejected(api, admin, field, value):
+    exam_id = api.make_exam(admin)
+    response = api.client.put(f"/exams/{exam_id}/settings", json={field: value}, headers=admin)
+    assert response.status_code == 422
+
+
+def test_students_receive_the_policy_with_the_exam(api, admin, student):
+    exam_id = api.make_exam(admin, max_violations=7, audio_min_duration_seconds=6)
+    payload = api.start_exam(exam_id, student)
+    assert payload["proctoring"]["max_violations"] == 7
+    assert payload["proctoring"]["audio_min_duration_seconds"] == 6
+    assert payload["violation_count"] == 0
+    assert "correct_answer" not in payload["questions"][0]
+
+
+# ---------------- vision pipeline (analysis is stubbed; no models needed) ----------------
+
+def _stub_frames(monkeypatch, *signal_lists):
+    frames = iter(signal_lists)
+
+    def fake_analyze(image, **_):
+        return {
+            "face_detected": False, "face_count": 0, "gaze_direction": "unknown",
+            "lip_moving": False, "signals": next(frames), "warnings": [],
+        }
+
+    monkeypatch.setattr(main.proctoring, "analyze_frame", fake_analyze)
+
+
+def test_a_signal_only_counts_after_it_persists(api, admin, student, monkeypatch):
+    exam_id = api.make_exam(admin, sustained_frames=3)
+    api.start_exam(exam_id, student)
+    no_face = [Signal("no_face", "No face detected", 2, 1.0)]
+    _stub_frames(monkeypatch, no_face, no_face, no_face, no_face)
+
+    counts = []
+    for _ in range(4):
+        body = api.client.post("/proctor/analyze", json={"exam_id": exam_id, "image": "x"}, headers=student).json()
+        counts.append(body["violation_count"])
+        assert body["skipped"] is False
+
+    assert counts == [0, 0, 1, 1]  # confirmed on the 3rd frame; the 4th is inside the cooldown
+
+
+def test_ai_violations_trigger_termination_at_the_limit(api, admin, student, monkeypatch):
+    exam_id = api.make_exam(admin, max_violations=2, sustained_frames=1, ai_cooldown_seconds=0)
+    api.start_exam(exam_id, student)
+    phone = [Signal("object_cell_phone", "Mobile phone detected", 2, 0.9)]
+    _stub_frames(monkeypatch, phone, phone, phone)
+
+    body = None
+    for _ in range(2):
+        body = api.client.post("/proctor/analyze", json={"exam_id": exam_id, "image": "x"}, headers=student).json()
+
+    assert body["terminated"] is True
+    assert body["logged"][0]["violation_type"] == "AI: Mobile phone detected"
+    # A terminated session is not analysed any further
+    after = api.client.post("/proctor/analyze", json={"exam_id": exam_id, "image": "x"}, headers=student).json()
+    assert after["skipped"] is True and after["terminated"] is True
+
+
+def test_a_crashing_analyser_never_breaks_the_exam(api, admin, student, monkeypatch):
+    exam_id = api.make_exam(admin)
+    api.start_exam(exam_id, student)
+
+    def boom(*_, **__):
+        raise RuntimeError("model exploded")
+
+    monkeypatch.setattr(main.proctoring, "analyze_frame", boom)
+    response = api.client.post("/proctor/analyze", json={"exam_id": exam_id, "image": "x"}, headers=student)
+    assert response.status_code == 200
+    assert response.json()["skipped"] is True
+
+
+def test_oversized_frames_are_rejected(api, admin, student):
+    exam_id = api.make_exam(admin)
+    api.start_exam(exam_id, student)
+    response = api.client.post(
+        "/proctor/analyze", json={"exam_id": exam_id, "image": "a" * 3_000_001}, headers=student
+    )
+    assert response.status_code == 413
+
+
+# ---------------- termination, results and overview ----------------
+
+def test_terminated_attempt_with_answers_gets_a_partial_score(api, admin, student):
+    exam_id = api.make_exam(admin, max_violations=1)
+    exam = api.start_exam(exam_id, student)
+    api.report(exam_id, student, "Tab switch detected")  # limit of 1 -> server terminates
+
+    # Options are shuffled per candidate, but "2" is the correct answer *text* for every sample question.
+    answers = {q["id"]: "2" for q in exam["questions"]}
+    response = api.client.post(
+        f"/exams/{exam_id}/terminate", json={"answers": answers, "reason": "Violation limit reached"}, headers=student
+    )
+    assert response.json() == {"status": "terminated"}
+
+    results = api.client.get(f"/exams/{exam_id}/results", headers=admin).json()
+    row = results["results"][0]
+    assert row["terminated"] is True
+    assert row["status"] == "terminated"
+    assert row["score"] == len(exam["questions"])
+    assert "Violation limit reached" in row["terminated_reason"]
+    assert results["terminated"] == 1 and results["average_percentage"] is None
+
+
+def test_terminated_attempt_without_answers_still_appears_in_results(api, admin, student):
+    exam_id = api.make_exam(admin, max_violations=1)
+    api.start_exam(exam_id, student)
+    api.report(exam_id, student, "Tab switch detected")
+
+    row = api.client.get(f"/exams/{exam_id}/results", headers=admin).json()["results"][0]
+    assert row["terminated"] is True
+    assert row["score"] is None and row["percentage"] is None
+    assert row["violation_count"] == 1
+
+
+def test_results_show_live_and_completed_candidates(api, admin, student):
+    exam_id = api.make_exam(admin)
+    other = api.make_user("other@test.com")
+    api.start_exam(exam_id, other)  # still sitting the exam
+
+    exam = api.start_exam(exam_id, student)
+    api.client.post(
+        f"/exams/{exam_id}/submit", json={"answers": {q["id"]: "2" for q in exam["questions"]}}, headers=student
+    )
+
+    results = api.client.get(f"/exams/{exam_id}/results", headers=admin).json()
+    assert results["completed"] == 1 and results["in_progress"] == 1
+    assert results["results"][0]["status"] == "submitted"  # scored rows first
+    assert results["results"][0]["percentage"] == 100
+    assert results["average_percentage"] == 100
+
+
+def test_terminate_cannot_undo_a_submission(api, admin, student):
+    exam_id = api.make_exam(admin)
+    api.start_exam(exam_id, student)
+    api.client.post(f"/exams/{exam_id}/submit", json={"answers": {}}, headers=student)
+    assert api.client.post(f"/exams/{exam_id}/terminate", headers=student).json() == {"status": "submitted"}
+
+
+def test_admin_overview_counts_and_recent_activity(api, admin, student):
+    exam_id = api.make_exam(admin)
+    api.start_exam(exam_id, student)
+    api.report(exam_id, student, "Tab switch detected")
+
+    overview = api.client.get("/admin/overview", headers=admin).json()
+    assert overview["exams"] == 1 and overview["students"] == 1
+    assert overview["violations"] == 1 and overview["active_sessions"] == 1
+    recent = overview["recent_violations"][0]
+    assert recent["student_name"] == "Student" and recent["exam_title"] == "Sample Exam"
+    assert api.client.get("/admin/overview", headers=student).status_code == 403
+
+
+# ---------------- exam creation ----------------
+
+def test_csv_upload_accepts_settings_and_excel_bom(api, admin):
+    csv_bytes = (
+        "﻿Question,Option A,Option B,Option C,Option D,Answer\n"
+        "2+2?,3,4,5,6,b\n"
+        "Capital of France?,Paris,Rome,Oslo,Bern,A\n"
+    ).encode("utf-8")
+    response = api.client.post(
+        "/exams/upload-csv",
+        data={"title": "CSV Exam", "duration_minutes": "15", "settings_json": '{"max_violations": 9}'},
+        files={"file": ("q.csv", csv_bytes, "text/csv")},
+        headers=admin,
+    )
+    assert response.status_code == 200, response.text
+    assert response.json()["question_count"] == 2
+    exam_id = response.json()["id"]
+    assert api.client.get(f"/exams/{exam_id}/settings", headers=admin).json()["max_violations"] == 9
+
+
+@pytest.mark.parametrize("csv_text,expected", [
+    ("Question,Option A\nq,a\n", "must have columns"),
+    ("Question,Option A,Option B,Option C,Option D,Answer\nq,a,b,c,d,Z\n", "must be A, B, C or D"),
+    ("Question,Option A,Option B,Option C,Option D,Answer\nq,a,b,,d,A\n", "incomplete"),
+])
+def test_bad_csv_is_rejected_without_creating_an_exam(api, admin, csv_text, expected):
+    response = api.client.post(
+        "/exams/upload-csv",
+        data={"title": "Bad", "duration_minutes": "10"},
+        files={"file": ("q.csv", csv_text.encode(), "text/csv")},
+        headers=admin,
+    )
+    assert response.status_code == 400
+    assert expected in response.json()["detail"]
+    assert api.client.get("/exams", headers=admin).json() == []
+
+
+def test_invalid_settings_json_in_csv_upload_is_rejected(api, admin):
+    response = api.client.post(
+        "/exams/upload-csv",
+        data={"title": "X", "duration_minutes": "10", "settings_json": '{"max_violations": 0}'},
+        files={"file": ("q.csv", b"Question,Option A,Option B,Option C,Option D,Answer\nq,a,b,c,d,A\n", "text/csv")},
+        headers=admin,
+    )
+    assert response.status_code == 422
+
+
+def test_exam_access_window_is_enforced_by_the_server(api, admin, student):
+    future = (datetime.now(timezone.utc) + timedelta(days=1)).isoformat()
+    past = (datetime.now(timezone.utc) - timedelta(days=2)).isoformat()
+    base = {"title": "Timed", "duration_minutes": 10, "questions": [
+        {"question_text": "q", "option_a": "a", "option_b": "b", "option_c": "c", "option_d": "d",
+         "correct_answer": "A"}]}
+
+    not_started = api.client.post("/exams", json={**base, "start_time": future, "end_time": future}, headers=admin)
+    ended = api.client.post("/exams", json={**base, "start_time": past, "end_time": past}, headers=admin)
+
+    early = api.client.get(f"/exams/{not_started.json()['id']}", headers=student)
+    late = api.client.get(f"/exams/{ended.json()['id']}", headers=student)
+    assert early.status_code == 403 and "hasn't started" in early.json()["detail"]
+    assert late.status_code == 403 and "ended" in late.json()["detail"]
