+    def update(self, key: Hashable, active_codes: Iterable[str]) -> dict[str, int]:
+        active = set(active_codes)
+
+        def step(streaks: dict) -> dict:
+            for code in active:
+                streaks[code] = streaks.get(code, 0) + 1
+            for code in list(streaks):
+                if code not in active:
+                    streaks[code] -= 1
+                    if streaks[code] <= 0:
+                        del streaks[code]
+            return dict(streaks)
+
+        return self._store.with_value(key, dict, step)
+
+    def reset(self, key: Hashable) -> None:
+        self._store.reset(key)
