+def get_exam_or_404(db: Session, exam_id: int) -> models.Exam:
+    exam = db.get(models.Exam, exam_id)
+    if not exam:
+        raise HTTPException(status_code=404, detail="Exam not found")
+    return exam
+
+
+def violation_state(db: Session, exam: models.Exam, session: models.ExamSession | None, student_id: int) -> dict:
+    """Where the candidate stands against the exam's violation limit."""
+    policy = ProctorPolicy.from_exam(exam)
+    count = violations.count_toward_limit(db, exam.id, student_id, policy)
+    return {
+        "violation_count": count,
+        "max_violations": policy.max_violations,
+        "remaining": max(0, policy.max_violations - count),
+        "terminated": bool(session and session.status == "terminated"),
+        "policy": policy.as_dict(),
+    }
+
+
+def score_answers(db: Session, locked_questions: list, answers: dict) -> int:
+    """Score ONLY questions that belong to the candidate's locked session; ignore everything else."""
+    valid_ids = {q["id"] for q in locked_questions}
+    questions = {
+        q.id: q for q in db.query(models.Question).filter(models.Question.id.in_(valid_ids)).all()
+    } if valid_ids else {}
+
+    score = 0
+    for question_id, submitted_text in answers.items():
+        question = questions.get(int(question_id))
+        if not question or not submitted_text:
+            continue
+        correct_text = {
+            "A": question.option_a,
+            "B": question.option_b,
+            "C": question.option_c,
+            "D": question.option_d,
+        }.get(question.correct_answer.upper())
+        if correct_text and submitted_text.strip() == correct_text.strip():
+            score += 1
+    return score
+
