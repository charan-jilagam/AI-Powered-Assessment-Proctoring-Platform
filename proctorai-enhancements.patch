+.questions { display: grid; gap: 16px; }
+.question { padding: 22px; border-radius: var(--radius-lg); border: 1px solid var(--line); background: var(--surface); scroll-margin-top: 130px; }
+.question.answered { border-color: var(--line-strong); }
+.question h3 { font-size: 16.5px; font-weight: 600; margin-bottom: 14px; display: flex; gap: 12px; }
+.question h3 .qn { color: var(--accent); min-width: 26px; }
+.options { display: grid; gap: 8px; }
+.option { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--bg); cursor: pointer; color: var(--text); transition: border-color 0.12s, background 0.12s; user-select: none; }
+.option:hover { border-color: var(--line-strong); }
+.option:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
+.option:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
+.option input { margin-top: 3px; accent-color: var(--accent); }
+.option .letter { font-weight: 700; color: var(--text-faint); min-width: 16px; }
+
+.side { position: sticky; top: 120px; display: grid; gap: 14px; }
+.cam { position: relative; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--line-strong); background: #000; aspect-ratio: 4 / 3; }
+.cam video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); display: block; }
+.cam-tag { position: absolute; left: 8px; top: 8px; }
+.status-list { display: grid; gap: 8px; font-size: 13.5px; }
+.status-list li { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 10px; }
+.mic { height: 8px; border-radius: 4px; background: var(--surface-3); overflow: hidden; position: relative; }
+.mic > span { position: absolute; inset: 0 auto 0 0; background: var(--ok); transition: width 0.08s linear; }
+.mic > i { position: absolute; top: -2px; bottom: -2px; width: 2px; background: var(--warn); }
+.navigator { display: grid; grid-template-columns: repeat(auto-fill, minmax(36px, 1fr)); gap: 6px; }
+.navigator a { display: grid; place-items: center; height: 34px; border-radius: 8px; border: 1px solid var(--line-strong); font-weight: 600; font-size: 13px; color: var(--text-muted); }
+.navigator a:hover { text-decoration: none; border-color: var(--accent); color: var(--text); }
+.navigator a.done { background: var(--accent-soft); border-color: var(--accent-line); color: var(--accent); }
+
+.alerts { position: fixed; top: 76px; left: 50%; transform: translateX(-50%); display: grid; gap: 8px; z-index: 900; width: min(420px, calc(100vw - 32px)); pointer-events: none; }
+.alerts .alert { box-shadow: var(--shadow); background: var(--surface); animation: slide 0.18s ease-out; }
+
+.gate { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
+.gate-card { width: 100%; max-width: 560px; }
+.rule-list { list-style: none; display: grid; gap: 14px; margin: 22px 0; }
+.rule-list li { display: grid; grid-template-columns: 34px 1fr; gap: 12px; }
+.rule-list .ico { width: 34px; height: 34px; border-radius: 9px; background: var(--surface-2); border: 1px solid var(--line); display: grid; place-items: center; color: var(--accent); }
+.rule-list strong { color: var(--text); font-weight: 600; display: block; font-size: 14.5px; }
+.rule-list span { font-size: 13.5px; color: var(--text-muted); }
+.big-number { font-size: 56px; font-weight: 600; letter-spacing: -0.03em; line-height: 1; color: var(--text); }
+
+/* ---------- responsive ---------- */
+@media (max-width: 900px) {
+  .auth { grid-template-columns: 1fr; }
+  .auth-aside { display: none; }
+  .room-body { grid-template-columns: 1fr; }
+  .side { position: static; order: -1; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
+  .setting { grid-template-columns: 1fr; }
+  .user-meta { display: none; }
+}
+@media (max-width: 560px) {
+  .topbar { gap: 8px; }
+  .nav { order: 3; width: 100%; }
+  .topbar { height: auto; flex-wrap: wrap; padding-top: 10px; padding-bottom: 6px; }
+  .feed li { grid-template-columns: auto 1fr; } .feed li time { grid-column: 2; }
+}
