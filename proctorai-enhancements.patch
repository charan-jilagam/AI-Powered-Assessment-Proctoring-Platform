+import { policyIsValid } from "../utils/policy";
+import PolicyEditor from "../components/PolicyEditor";
+import { Alert, Loading, PageHead } from "../components/ui";
+
+export default function ExamSettings() {
+  const { examId } = useParams();
+  const toast = useToast();
+  const { data, error, loading } = useAsync(async () => {
+    const [settings, exams] = await Promise.all([apiCall(`/exams/${examId}/settings`), apiCall("/exams/available")]);
+    return { settings, exam: exams.find((e) => String(e.id) === String(examId)) };
+  }, [examId]);
+
+  const [draft, setDraft] = useState(null);
+  const [saved, setSaved] = useState(null);
+  const [saving, setSaving] = useState(false);
+
+  // Adopt the loaded policy once (the server value is the baseline for "unsaved changes").
+  const baseline = saved || data?.settings;
+  const value = draft || baseline;
+  const dirty = Boolean(draft) && JSON.stringify(draft) !== JSON.stringify(baseline);
+
+  async function save() {
+    if (!policyIsValid(value)) {
+      toast.error("One of the settings is outside its allowed range.");
+      return;
+    }
+    setSaving(true);
+    try {
+      const result = await apiCall(`/exams/${examId}/settings`, "PUT", value);
+      setSaved(result);
+      setDraft(null);
+      toast.success("Proctoring settings saved. They apply to running exams immediately.");
+    } catch (err) {
+      toast.error(err.message);
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  return (
+    <>
+      <PageHead
+        title="Proctoring settings"
+        breadcrumb={<><Link to="/dashboard">Overview</Link> / {data?.exam?.title || `Exam ${examId}`}</>}
+        subtitle="Choose when an exam ends automatically and how sensitive the camera and voice checks are."
+      />
+      {error && <Alert tone="error">{error}</Alert>}
+      {loading && <Loading />}
+      {value && (
+        <>
+          <Alert tone="info">
+            Changes take effect right away for candidates already sitting this exam. A candidate who is already over a
+            lowered limit is ended on their next violation.
+          </Alert>
+          <div className="card" style={{ marginTop: 16 }}>
+            <PolicyEditor value={value} onChange={setDraft} />
+          </div>
+          <div className="savebar">
+            <span className="muted small">{dirty ? "You have unsaved changes." : "All changes saved."}</span>
+            <div className="row">
+              <button className="btn" disabled={!dirty || saving} onClick={() => setDraft(null)}>Discard</button>
+              <button className="btn primary" disabled={!dirty || saving} onClick={save}>
+                {saving ? "Saving..." : "Save settings"}
+              </button>
+            </div>
+          </div>
+        </>
+      )}
+    </>
+  );
+}
