+++ b/frontend/src/components/PolicyEditor.jsx
@@ -0,0 +1,134 @@
+import { POLICY_PRESETS, matchingPreset } from "../utils/policy";
+import { Switch } from "./ui";
+
+function Slider({ value, min, max, step, onChange, format, disabled }) {
+  return (
+    <div className="range-row">
+      <input
+        className="range"
+        type="range"
+        min={min}
+        max={max}
+        step={step}
+        value={value}
+        disabled={disabled}
+        onChange={(e) => onChange(Number(e.target.value))}
+      />
+      <span className="range-value">{format(value)}</span>
+    </div>
+  );
+}
+
+function Setting({ title, help, off = false, children }) {
+  return (
+    <div className={`setting ${off ? "off" : ""}`}>
+      <div>
+        <h4>{title}</h4>
+        <p>{help}</p>
+      </div>
+      <div className="control">{children}</div>
+    </div>
+  );
+}
+
+const percent = (v) => `${Math.round(v * 100)}%`;
+const seconds = (v) => `${v}s`;
+
+/**
+ * Admin controls for an exam's proctoring policy. Controlled component: `value` is the 8-field policy
+ * object, `onChange` receives the next one. Used when creating an exam and on the settings page.
+ */
+export default function PolicyEditor({ value, onChange, disabled = false }) {
+  const set = (key) => (next) => onChange({ ...value, [key]: next });
+  const active = matchingPreset(value);
+  const audioOff = !value.audio_monitoring_enabled;
+
+  return (
+    <div>
+      <div className="preset-grid" role="group" aria-label="Policy presets">
+        {POLICY_PRESETS.map((preset) => (
+          <button
+            key={preset.id}
+            type="button"
+            className="preset"
+            aria-pressed={active === preset.id}
+            disabled={disabled}
+            onClick={() => onChange({ ...preset.values })}
+          >
+            <strong>{preset.name}</strong>
+            <span>{preset.blurb}</span>
+          </button>
+        ))}
+      </div>
+      {active === "custom" && <p className="hint" style={{ marginTop: 10 }}>Custom settings: values differ from every preset.</p>}
+
+      <div style={{ marginTop: 18 }}>
+        <Setting
+          title="Violation limit"
+          help="The exam ends automatically and is marked as terminated once a candidate reaches this many violations."
+        >
+          <Slider value={value.max_violations} min={1} max={20} step={1} onChange={set("max_violations")}
+            format={(v) => `${v} ${v === 1 ? "strike" : "strikes"}`} disabled={disabled} />
+        </Setting>
+
+        <Setting
+          title="Count minor warnings"
+          help="Minor events (looking away, lip movement, talking) count toward the limit. Turn this off to only count serious events such as a phone, a second person, or leaving the tab."
+        >
+          <Switch checked={value.count_minor_violations} onChange={set("count_minor_violations")}
+            label={value.count_minor_violations ? "Counted" : "Recorded only"} disabled={disabled} />
+        </Setting>
+
+        <Setting
+          title="Repeat-alert cooldown"
+          help="After the AI flags something, the same kind of event is not counted again for this long, so one long glance is one strike, not twenty."
+        >
+          <Slider value={value.ai_cooldown_seconds} min={0} max={180} step={5} onChange={set("ai_cooldown_seconds")}
+            format={seconds} disabled={disabled} />
+        </Setting>
+
+        <Setting
+          title="Frames needed to confirm"
+          help="A camera signal must appear in this many checks in a row (about 1.5 s each) before it is counted. Higher means fewer false alarms from a blink or a passing shadow."
+        >
+          <Slider value={value.sustained_frames} min={1} max={10} step={1} onChange={set("sustained_frames")}
+            format={(v) => `${v} checks`} disabled={disabled} />
+        </Setting>
+
+        <Setting
+          title="Object detection confidence"
+          help="How sure the camera AI must be that it sees a phone, book or laptop. Raise it if it flags things that aren't there."
+        >
+          <Slider value={value.object_confidence_threshold} min={0.25} max={0.95} step={0.05}
+            onChange={set("object_confidence_threshold")} format={percent} disabled={disabled} />
+        </Setting>
+
+        <Setting
+          title="Voice monitoring"
+          help="Listens for talking. Background noise such as a fan or traffic is learned in the first seconds and ignored."
+        >
+          <Switch checked={value.audio_monitoring_enabled} onChange={set("audio_monitoring_enabled")}
+            label={value.audio_monitoring_enabled ? "On" : "Off"} disabled={disabled} />
+        </Setting>
+
+        <Setting
+          title="Voice confidence threshold"
+          help="How speech-like a sound must be before it counts. Raise it if noise is still flagged, lower it if real talking is missed."
+          off={audioOff}
+        >
+          <Slider value={value.audio_confidence_threshold} min={0.3} max={0.95} step={0.05}
+            onChange={set("audio_confidence_threshold")} format={percent} disabled={disabled || audioOff} />
+        </Setting>
+
+        <Setting
+          title="Minimum talking time"
+          help="Speech must continue this long before it is reported. Short coughs and single words are ignored."
+          off={audioOff}
+        >
+          <Slider value={value.audio_min_duration_seconds} min={1} max={15} step={0.5}
+            onChange={set("audio_min_duration_seconds")} format={seconds} disabled={disabled || audioOff} />
+        </Setting>
+      </div>
+    </div>
+  );
+}
