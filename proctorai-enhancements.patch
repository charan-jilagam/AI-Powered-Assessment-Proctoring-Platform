+"""
+Test bootstrap: give the app safe defaults so the suite runs on a clean checkout / CI
+(no .env, no Postgres, no AI model files required) and provide shared API fixtures.
+"""
+import os
+
+os.environ.setdefault("DATABASE_URL", "sqlite:///:memory:")
+os.environ.setdefault("SECRET_KEY", "test-secret-key-not-for-production")
+os.environ["PROCTOR_WARMUP"] = "0"  # never try to load MediaPipe / YOLO during tests
+
+import bcrypt
+import pytest
+from fastapi.testclient import TestClient
+from sqlalchemy import create_engine
+from sqlalchemy.orm import sessionmaker
+from sqlalchemy.pool import StaticPool
+
+from app import main, models
+from app.database import Base, get_db
+from app.policy import SignalTracker
+
+SAMPLE_QUESTIONS = [
+    {"question_text": f"Question {i}?", "option_a": "1", "option_b": "2", "option_c": "3", "option_d": "4",
+     "correct_answer": "B"}
+    for i in range(1, 4)
+]
+
+
+class Api:
+    """Thin helper around TestClient + an isolated in-memory database."""
+
+    def __init__(self, client, session_factory):
+        self.client = client
+        self.session_factory = session_factory
+
+    # ---- accounts ----
+    def make_user(self, email, role="student", password="password123", name=None):
+        with self.session_factory() as db:
+            db.add(models.User(
+                full_name=name or email.split("@")[0].title(),
+                email=email,
+                # cost 4 keeps the suite fast; login verification works with any bcrypt cost
+                hashed_password=bcrypt.hashpw(password.encode(), bcrypt.gensalt(rounds=4)).decode(),
+                role=role,
+            ))
+            db.commit()
+        response = self.client.post("/auth/login", json={"email": email, "password": password})
+        assert response.status_code == 200, response.text
+        return {"Authorization": f"Bearer {response.json()['access_token']}"}
+
+    # ---- exams ----
+    def make_exam(self, admin_headers, **proctoring):
+        body = {
+            "title": "Sample Exam",
+            "description": "desc",
+            "duration_minutes": 30,
+            "questions": SAMPLE_QUESTIONS,
+        }
+        if proctoring:
+            body["proctoring"] = proctoring
+        response = self.client.post("/exams/create", json=body, headers=admin_headers)
+        assert response.status_code == 200, response.text
+        return response.json()["id"]
+
+    def start_exam(self, exam_id, headers):
+        response = self.client.get(f"/exams/{exam_id}", headers=headers)
+        assert response.status_code == 200, response.text
+        return response.json()
+
+    def report(self, exam_id, headers, violation_type, **extra):
+        return self.client.post(
+            f"/exams/{exam_id}/violations", json={"violation_type": violation_type, **extra}, headers=headers
+        )
+
+
+@pytest.fixture
+def api(monkeypatch):
+    engine = create_engine(
+        "sqlite:///:memory:", connect_args={"check_same_thread": False}, poolclass=StaticPool
+    )
+    Base.metadata.create_all(bind=engine)
+    session_factory = sessionmaker(autocommit=False, autoflush=False, bind=engine)
+
+    def override_get_db():
+        db = session_factory()
+        try:
+            yield db
+        finally:
+            db.close()
+
+    previous_override = main.app.dependency_overrides.get(get_db)
+    main.app.dependency_overrides[get_db] = override_get_db
+    main.app.state.limiter.enabled = False
+    monkeypatch.setattr(main, "signal_tracker", SignalTracker())  # no state leaking between tests
+
+    yield Api(TestClient(main.app), session_factory)
+
+    if previous_override is not None:
+        main.app.dependency_overrides[get_db] = previous_override
+    else:
+        main.app.dependency_overrides.pop(get_db, None)
+    engine.dispose()
+
+
+@pytest.fixture
+def admin(api):
+    return api.make_user("admin@test.com", role="admin")
+
+
+@pytest.fixture
+def student(api):
+    return api.make_user("student@test.com")
