@@ -0,0 +1,120 @@
+"""
+Server-authoritative violation handling.
+
+The browser only *reports* things; this module decides whether a report becomes a counted
+violation (cooldown / dedupe), keeps the running total, and terminates the exam the moment
+the exam's `max_violations` limit is reached. Nothing here trusts the client's own counter.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import datetime, timezone
+
+from sqlalchemy import func
+from sqlalchemy.orm import Session
+
+from app import audit, models
+from app.policy import BROWSER_DEDUPE_SECONDS, ProctorPolicy, seconds_since
+
+
+@dataclass
+class RecordResult:
+    logged: bool
+    violation: models.Violation | None
+    reason: str | None
+    count: int
+    terminated: bool
+
+
+def get_session(db: Session, exam_id: int, student_id: int) -> models.ExamSession | None:
+    return (
+        db.query(models.ExamSession)
+        .filter(models.ExamSession.exam_id == exam_id, models.ExamSession.student_id == student_id)
+        .first()
+    )
+
+
+def count_toward_limit(db: Session, exam_id: int, student_id: int, policy: ProctorPolicy) -> int:
+    """How many of this candidate's violations count toward the exam's limit."""
+    query = db.query(func.count(models.Violation.id)).filter(
+        models.Violation.exam_id == exam_id,
+        models.Violation.student_id == student_id,
+    )
+    if not policy.count_minor_violations:
+        query = query.filter(models.Violation.level >= 2)
+    return query.scalar() or 0
+
+
+def _within_cooldown(db: Session, exam_id: int, student_id: int, violation_type: str, window: float) -> bool:
+    if window <= 0:
+        return False
+    last = (
+        db.query(models.Violation)
+        .filter(
+            models.Violation.exam_id == exam_id,
+            models.Violation.student_id == student_id,
+            models.Violation.violation_type == violation_type,
+        )
+        .order_by(models.Violation.id.desc())
+        .first()
+    )
+    return bool(last and last.created_at and seconds_since(last.created_at) < window)
+
+
+def terminate_session(db: Session, session: models.ExamSession, reason: str, student_email: str = "system") -> None:
+    if session.status == "terminated":
+        return
+    session.status = "terminated"
+    session.terminated_reason = reason
+    session.ended_at = datetime.now(timezone.utc)
+    db.commit()
+    audit.log_event("EXAM_TERMINATED", student_email, f"exam_id={session.exam_id} reason='{reason}'")
+
+
+def record_violation(
+    db: Session,
+    *,
+    session: models.ExamSession,
+    student: models.User,
+    policy: ProctorPolicy,
+    violation_type: str,
+    level: int,
+    source: str,
+    confidence: float | None = None,
+    details: str | None = None,
+) -> RecordResult:
+    """Record one violation (unless debounced) and terminate the exam if the limit is reached."""
+    exam_id, student_id = session.exam_id, student.id
+
+    def count() -> int:
+        return count_toward_limit(db, exam_id, student_id, policy)
+
+    if session.status != "in_progress":
+        return RecordResult(False, None, "session_not_active", count(), session.status == "terminated")
+
+    window = BROWSER_DEDUPE_SECONDS if source == "browser" else policy.ai_cooldown_seconds
+    if _within_cooldown(db, exam_id, student_id, violation_type, window):
+        return RecordResult(False, None, "cooldown", count(), False)
+
+    violation = models.Violation(
+        exam_id=exam_id,
+        student_id=student_id,
+        violation_type=violation_type,
+        details=details,
+        level=level,
+        source=source,
+        confidence=confidence,
+    )
+    db.add(violation)
+    db.commit()
+    db.refresh(violation)
+
+    total = count()
+    terminated = False
+    if total >= policy.max_violations:
+        terminate_session(
+            db, session, f"Violation limit reached ({total}/{policy.max_violations})", student.email
+        )
+        terminated = True
+
+    return RecordResult(True, violation, None, total, terminated)
