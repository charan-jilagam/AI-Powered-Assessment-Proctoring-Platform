@@ -0,0 +1,275 @@
+"""
+Proctoring policy.
+
+Everything that decides whether a raw detection becomes a *violation* lives here:
+  * the admin-configurable settings (violation limit, audio confidence, sustained-frame
+    requirement, cooldowns) with their defaults and bounds,
+  * violation classification (minor = level 1, serious = level 2),
+  * debouncing helpers (consecutive-frame confirmation, lip-motion tracking).
+
+This module deliberately has NO heavy dependencies (no OpenCV / MediaPipe / FastAPI /
+SQLAlchemy) so the rules can be unit-tested anywhere and reused by any entry point.
+"""
+from __future__ import annotations
+
+import threading
+import time
+from collections import deque
+from dataclasses import asdict, dataclass
+from datetime import datetime, timezone
+from statistics import pstdev
+from typing import Callable, Hashable, Iterable
+
+# --------------------------------------------------------------------------- #
+# Admin-configurable settings
+# --------------------------------------------------------------------------- #
+
+DEFAULT_SETTINGS: dict = {
+    # Hard limit: once this many counted violations are recorded, the exam is terminated.
+    "max_violations": 5,
+    # If False, minor (level 1) violations are logged for review but do not count toward the limit.
+    "count_minor_violations": True,
+    # AI detections (vision + audio) of the same type are counted at most once per this window.
+    "ai_cooldown_seconds": 30,
+    # A vision signal must persist for this many analysed frames (~1.5 s each) before it counts.
+    "sustained_frames": 3,
+    # Minimum YOLO confidence for a prohibited object to be considered.
+    "object_confidence_threshold": 0.50,
+    # Voice / talking detection (runs in the browser; the server re-validates every report).
+    "audio_monitoring_enabled": True,
+    # Minimum voice-likelihood score (0..1). Fan / AC / traffic noise scores far below speech.
+    "audio_confidence_threshold": 0.70,
+    # Speech must be sustained for at least this long before it is reported.
+    "audio_min_duration_seconds": 4.0,
+}
+
+# Inclusive (min, max) bounds, enforced by the API schema.
+SETTING_BOUNDS: dict = {
+    "max_violations": (1, 50),
+    "ai_cooldown_seconds": (0, 600),
+    "sustained_frames": (1, 10),
+    "object_confidence_threshold": (0.25, 0.95),
+    "audio_confidence_threshold": (0.30, 0.95),
+    "audio_min_duration_seconds": (1.0, 30.0),
+}
+
+# Browser events (tab switch, fullscreen exit...) fire twice for a single user action in some
+# browsers, so identical events inside this window are collapsed into one.
+BROWSER_DEDUPE_SECONDS = 3
+
+# Audio detections at or above this confidence are treated as serious (level 2).
+HIGH_CONFIDENCE_AUDIO = 0.85
+
+
+@dataclass(frozen=True)
+class ProctorPolicy:
+    max_violations: int = DEFAULT_SETTINGS["max_violations"]
+    count_minor_violations: bool = DEFAULT_SETTINGS["count_minor_violations"]
+    ai_cooldown_seconds: int = DEFAULT_SETTINGS["ai_cooldown_seconds"]
+    sustained_frames: int = DEFAULT_SETTINGS["sustained_frames"]
+    object_confidence_threshold: float = DEFAULT_SETTINGS["object_confidence_threshold"]
+    audio_monitoring_enabled: bool = DEFAULT_SETTINGS["audio_monitoring_enabled"]
+    audio_confidence_threshold: float = DEFAULT_SETTINGS["audio_confidence_threshold"]
+    audio_min_duration_seconds: float = DEFAULT_SETTINGS["audio_min_duration_seconds"]
+
+    @classmethod
+    def from_exam(cls, exam) -> "ProctorPolicy":
+        """Build a policy from an Exam row, falling back to defaults for missing/NULL values."""
+        values = {}
+        for key, default in DEFAULT_SETTINGS.items():
+            value = getattr(exam, key, None)
+            values[key] = default if value is None else value
+        return cls(**values)
+
+    def as_dict(self) -> dict:
+        return asdict(self)
+
+    def counts_toward_limit(self, level: int) -> bool:
+        return level >= 2 or self.count_minor_violations
+
+
+# --------------------------------------------------------------------------- #
+# Classification
+# --------------------------------------------------------------------------- #
+
+AI_PREFIX = "AI: "
+
+# Browser-side events that are only warnings (level 1). Anything else from the browser is serious.
+BROWSER_MINOR_EVENTS = frozenset(
+    {"Attempted copy/paste/cut", "Attempted right-click", "Keyboard shortcut attempted"}
+)
+
+# Keyword fallback used ONLY for legacy rows that were stored before levels were persisted.
+_LEGACY_SEVERE_KEYWORDS = (
+    "no face", "multiple faces", "phone", "book", "laptop", "tv", "remote", "keyboard", "mouse", "mobile",
+)
+
+
