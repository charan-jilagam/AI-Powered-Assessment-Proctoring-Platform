+
+def test_when_the_face_model_is_unavailable_people_come_from_the_object_model():
+    assert codes(P.build_findings(None, [det("person", 0.9, ME), det("person", 0.8, (0.78, 0.3, 0.98, 1.0))])["findings"]) == ["MULTIPLE_PERSONS"]
