+def covered_share(inner: Box, outer: Box) -> float:
+    """How much of `inner` lies inside `outer` (0..1). Unlike IoU this ignores how big `outer` is."""
+    a = _area(inner)
+    return _intersection(inner, outer) / a if a > 0 else 0.0
