+def _invite(db: Session, exam: models.Exam, invite_id: int) -> models.Invite:
+    inv = db.query(models.Invite).filter(models.Invite.id == invite_id, models.Invite.exam_id == exam.id).first()
+    if inv is None:
+        raise not_found("Invite")
+    return inv
