-+            label = f"Sample {sample_no}"
-+        else:
-+            hidden_no += 1
-+            label = f"Hidden {hidden_no}"
-+
-+        entry = {
-+            "label": label,
-+            "is_sample": bool(case["is_sample"]),
-+            "passed": ok,
-+            "verdict": verdict,
-+            "time": raw["time"],
