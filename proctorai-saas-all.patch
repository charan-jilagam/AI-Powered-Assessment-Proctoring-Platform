-+def _raw(status_id=3, status="Accepted", stdout="", stderr="", compile_output=""):
-+    return {"status_id": status_id, "status": status, "stdout": stdout, "stderr": stderr,
-+            "compile_output": compile_output, "message": "", "time": 0.01, "memory": 1024}
