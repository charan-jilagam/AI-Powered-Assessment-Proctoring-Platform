@@ -0,0 +1,36 @@
+import { useState } from 'react'
+import { KeyRound, UserPlus } from 'lucide-react'
+import { api } from '../../lib/api'
+import { useAuth } from '../../lib/auth'
+import { fmtDateTime } from '../../lib/format'
+import { useDocumentTitle } from '../../lib/hooks'
+import { Alert, Async, Badge, Button, PageHeader, Panel, useLoad, useUI } from '../../ui'
+import { AddStaffModal, LinkModal } from '../../ui/staff'
+
+export default function Team() {
+  useDocumentTitle('Team')
+  const { user: me, org } = useAuth()
+  const { error, toast } = useUI()
+  const state = useLoad(() => api.get('/org/team'), [])
+  const [adding, setAdding] = useState(false)
+  const [link, setLink] = useState(null)
+  const patch = async (u, body, msg) => { try { await api.patch(`/org/team/${u.id}`, body); toast(msg); state.reload() } catch (e) { error(e) } }
+  return (
+    <>
+      <PageHeader title="Team" subtitle="Admins build tests and manage the organization. Reviewers watch live exams and review results."><Button variant="primary" icon={UserPlus} onClick={() => setAdding(true)}>Add member</Button></PageHeader>
+      <Async state={state}>{(rows) => (
+        <>
+          <Alert tone="info">{rows.length} seat{rows.length === 1 ? '' : 's'} used on the {org.plan_name} plan.</Alert>
+          <Panel flush><div className="table-wrap"><table className="t"><thead><tr><th>Member</th><th>Role</th><th>Status</th><th>Last sign-in</th><th /></tr></thead><tbody>
+            {rows.map((u) => { const self = u.id === me.id; return (
+              <tr key={u.id}><td><b>{u.full_name}</b> {self && <Badge tone="info">You</Badge>}<div className="sub">{u.email}</div></td>
+                <td>{self ? <Badge tone="info" status={u.role} /> : <select className="input" style={{ width: 'auto', height: 32 }} aria-label={`Role for ${u.full_name}`} value={u.role} onChange={(e) => patch(u, { role: e.target.value }, 'Role updated')}><option value="admin">Admin</option><option value="reviewer">Reviewer</option></select>}</td>
+                <td>{u.is_active ? <Badge status="active" /> : <Badge status="suspended">Disabled</Badge>}</td><td className="muted">{u.last_login_at ? fmtDateTime(u.last_login_at) : 'Never'}</td>
+                <td className="num nowrap">{!self && <><Button size="sm" icon={KeyRound} onClick={async () => { try { const r = await api.post(`/org/team/${u.id}/reset-link`); setLink({ title: `Reset link for ${u.full_name}`, url: r.reset_url }) } catch (e) { error(e) } }}>Reset link</Button>{' '}<Button size="sm" onClick={() => patch(u, { is_active: !u.is_active }, u.is_active ? 'Member disabled' : 'Member enabled')}>{u.is_active ? 'Disable' : 'Enable'}</Button></>}</td></tr>) })}
+          </tbody></table></div></Panel></>
+      )}</Async>
+      {adding && <AddStaffModal allowTempPassword={false} onClose={() => { setAdding(false); state.reload() }} onSubmit={(b) => api.post('/org/team', { full_name: b.full_name, email: b.email, role: b.role })} />}
+      {link && <LinkModal title={link.title} url={link.url} onClose={() => setLink(null)} />}
+    </>
+  )
+}
diff --git a/frontend/src/pages/admin/TestDetail.jsx b/frontend/src/pages/admin/TestDetail.jsx
new file mode 100644
index 0000000..0cac9ef
--- /dev/null
+++ b/frontend/src/pages/admin/TestDetail.jsx
@@ -0,0 +1,87 @@
+import { lazy, Suspense, useState } from 'react'
+import { NavLink, Route, Routes, useNavigate, useParams } from 'react-router-dom'
+import { Archive, Copy, ExternalLink, Pause, Play, RefreshCw, Trash2, Undo2 } from 'lucide-react'
+import { api } from '../../lib/api'
+import { useAuth } from '../../lib/auth'
+import { useDocumentTitle } from '../../lib/hooks'
+import { Async, Badge, Button, CodeTicket, Loading, PageHeader, useLoad, useUI } from '../../ui'
+
+const Overview = lazy(() => import('./test/Overview'))
+const Questions = lazy(() => import('./test/Questions'))
+const Coding = lazy(() => import('./test/Coding'))
+const Settings = lazy(() => import('./test/Settings'))
+const Invites = lazy(() => import('./test/Invites'))
+const Results = lazy(() => import('./test/Results'))
+const Live = lazy(() => import('./test/Live'))
+const Analytics = lazy(() => import('./test/Analytics'))
+
+export default function TestDetail() {
+  const { id } = useParams()
+  const nav = useNavigate()
+  const { user } = useAuth()
+  const { toast, error, confirm } = useUI()
+  const state = useLoad(() => api.get(`/tests/${id}`), [id])
+  const [busy, setBusy] = useState('')
+  const isAdmin = user.role === 'admin'
+  useDocumentTitle(state.data?.title)
+
+  async function act(kind, label, confirmOpts) {
+    if (confirmOpts && !(await confirm(confirmOpts))) return
+    setBusy(kind)
+    try {
+      const r = await api.post(`/tests/${id}/${kind}`)
+      toast(label)
+      if (kind === 'duplicate') nav(`/app/tests/${r.id}`)
+      else state.reload()
+    } catch (e) { error(e) } finally { setBusy('') }
+  }
+  async function remove() {
+    if (!(await confirm({ title: 'Delete this test?', message: 'Its questions are deleted too. Tests with candidate data cannot be deleted — archive them instead.', confirmLabel: 'Delete test', danger: true }))) return
+    try { await api.del(`/tests/${id}`); toast('Test deleted'); nav('/app/tests', { replace: true }) } catch (e) { error(e) }
+  }
+
+  return (
+    <Async state={state}>{(t) => {
+      const ctx = { test: t, reload: state.reload, isAdmin }
+      const tabs = [
+        ['', 'Overview'], ['questions', `Questions (${t.question_count})`], ...(isAdmin ? [['coding', `Coding (${t.coding_problem_count})`]] : []),
+        ...(isAdmin ? [['settings', 'Settings'], ['invites', 'Invites']] : []),
+        ['results', `Results (${t.attempts_total})`], ['live', t.attempts.in_progress ? `Live (${t.attempts.in_progress})` : 'Live'], ['analytics', 'Analytics'],
+      ]
+      return (
+        <>
+          <PageHeader title={t.title} crumbs={[{ label: 'Tests', to: '/app/tests' }, { label: t.title }]}>
+            <Badge status={t.status} />
+            {isAdmin && t.status === 'draft' && <Button variant="primary" icon={Play} busy={busy === 'publish'} onClick={() => act('publish', 'Published — candidates can join with the code')}>Publish</Button>}
+            {isAdmin && t.status === 'published' && <Button icon={Pause} busy={busy === 'close'} onClick={() => act('close', 'Closed to new candidates', { title: 'Close this test?', message: 'New candidates can no longer join. People already taking it can finish.', confirmLabel: 'Close test' })}>Close</Button>}
+            {isAdmin && t.status === 'closed' && <Button icon={Play} onClick={() => act('publish', 'Reopened')}>Reopen</Button>}
+            {isAdmin && (t.status === 'published' || t.status === 'closed') && t.attempts_total === 0 && <Button icon={Undo2} onClick={() => act('unpublish', 'Moved back to draft')}>Unpublish</Button>}
+            {isAdmin && <Button icon={Copy} busy={busy === 'duplicate'} onClick={() => act('duplicate', 'Test duplicated')}>Duplicate</Button>}
+          </PageHeader>
+          <div className="row wrap mb" style={{ marginTop: -6 }}>
+            <CodeTicket code={t.code} display={t.code_display} />
+            <span className="muted-2" style={{ fontSize: 13 }}>or share <a href={t.join_url} target="_blank" rel="noreferrer">{t.join_url} <ExternalLink size={12} /></a></span>
+            {isAdmin && <span className="right row">
+              <Button size="sm" icon={RefreshCw} onClick={() => act('regenerate-code', 'New code generated', { title: 'Generate a new code?', message: 'The current code stops working immediately. Invitation links keep working.', confirmLabel: 'New code' })}>New code</Button>
+              {t.status !== 'archived' && <Button size="sm" icon={Archive} onClick={() => act('archive', 'Archived', { title: 'Archive this test?', message: 'Candidates can no longer join. Results stay available.', confirmLabel: 'Archive' })}>Archive</Button>}
+              <Button size="sm" variant="ghost" icon={Trash2} onClick={remove} aria-label="Delete test" />
+            </span>}
+          </div>
+          <div className="tabs">{tabs.map(([to, label]) => <NavLink key={to} to={to ? `/app/tests/${id}/${to}` : `/app/tests/${id}`} end={!to} className={({ isActive }) => (isActive ? 'active' : '')}>{label}</NavLink>)}</div>
+          <Suspense fallback={<Loading />}>
+            <Routes>
+              <Route index element={<Overview {...ctx} />} />
+              <Route path="questions" element={<Questions {...ctx} />} />
+              <Route path="coding" element={<Coding {...ctx} />} />
+              <Route path="settings" element={<Settings {...ctx} />} />
+              <Route path="invites" element={<Invites {...ctx} />} />
+              <Route path="results" element={<Results {...ctx} />} />
+              <Route path="live" element={<Live {...ctx} />} />
+              <Route path="analytics" element={<Analytics {...ctx} />} />
+            </Routes>
+          </Suspense>
+        </>
+      )
+    }}</Async>
+  )
+}
diff --git a/frontend/src/pages/admin/TestNew.jsx b/frontend/src/pages/admin/TestNew.jsx
new file mode 100644
index 0000000..85fccdc
--- /dev/null
+++ b/frontend/src/pages/admin/TestNew.jsx
@@ -0,0 +1,35 @@
+import { useState } from 'react'
+import { useNavigate } from 'react-router-dom'
+import { api } from '../../lib/api'
+import { useDocumentTitle } from '../../lib/hooks'
+import { Alert, Button, Input, PageHeader, Panel, Textarea, useUI } from '../../ui'
+
+export default function TestNew() {
+  useDocumentTitle('New test')
+  const nav = useNavigate()
+  const { error } = useUI()
+  const [f, setF] = useState({ title: '', description: '', duration_minutes: 60, pass_percentage: 40 })
+  const [busy, setBusy] = useState(false)
+  const set = (k) => (e) => setF({ ...f, [k]: e.target.value })
+  async function submit(e) {
+    e.preventDefault(); setBusy(true)
+    try {
+      const t = await api.post('/tests', { title: f.title.trim(), description: f.description.trim() || null, duration_minutes: Number(f.duration_minutes), pass_percentage: Number(f.pass_percentage), questions: [] })
+      nav(`/app/tests/${t.id}/questions`, { replace: true })
+    } catch (x) { error(x); setBusy(false) }
+  }
+  return (
+    <>
+      <PageHeader title="New test" crumbs={[{ label: 'Tests', to: '/app/tests' }, { label: 'New' }]} subtitle="Start with the basics. You will add questions, proctoring and access rules next." />
+      <form onSubmit={submit} style={{ maxWidth: 640 }}>
+        <Panel>
+          <Input label="Test title" required autoFocus value={f.title} onChange={set('title')} placeholder="e.g. Java Developer Screening — Round 1" />
+          <Textarea label="Description" value={f.description} onChange={set('description')} hint="Candidates see this before they start." />
+          <div className="grid c2"><Input label="Duration (minutes)" type="number" min="1" max="720" required value={f.duration_minutes} onChange={set('duration_minutes')} /><Input label="Passing score (%)" type="number" min="0" max="100" value={f.pass_percentage} onChange={set('pass_percentage')} /></div>
+          <Alert tone="info">A unique test code is generated automatically. Candidates use it to sign in once you publish.</Alert>
+          <Button variant="primary" type="submit" busy={busy}>Create and add questions</Button>
+        </Panel>
+      </form>
+    </>
+  )
+}
diff --git a/frontend/src/pages/admin/Tests.jsx b/frontend/src/pages/admin/Tests.jsx
new file mode 100644
index 0000000..2014dee
--- /dev/null
+++ b/frontend/src/pages/admin/Tests.jsx
@@ -0,0 +1,40 @@
+import { Link, useNavigate } from 'react-router-dom'
+import { Plus } from 'lucide-react'
+import { fmtDateTime } from '../../lib/format'
+import { useAuth } from '../../lib/auth'
+import { useDocumentTitle, usePaged } from '../../lib/hooks'
+import { Badge, CodeTicket, Empty, Loading, PageHeader, Pager, Panel, SearchBox } from '../../ui'
+
+export default function Tests() {
+  useDocumentTitle('Tests')
+  const { user } = useAuth()
+  const nav = useNavigate()
+  const list = usePaged('/tests', { q: '', status: '' })
+  const isAdmin = user.role === 'admin'
+  return (
+    <>
+      <PageHeader title="Tests" subtitle="Each test has its own code. Candidates enter the code to sign in.">{isAdmin && <Link className="btn primary" to="/app/tests/new"><Plus size={16} />New test</Link>}</PageHeader>
+      <div className="toolbar">
+        <SearchBox value={list.filters.q} onChange={(v) => list.setFilter('q', v)} placeholder="Search tests" />
+        <select className="input" aria-label="Status" value={list.filters.status} onChange={(e) => list.setFilter('status', e.target.value)}><option value="">All statuses</option>{['draft', 'published', 'closed', 'archived'].map((s) => <option key={s} value={s}>{s[0].toUpperCase() + s.slice(1)}</option>)}</select>
+      </div>
+      <Panel flush>
+        {list.loading && !list.data ? <Loading /> : !list.items.length ? (
+          <Empty title={list.filters.q || list.filters.status ? 'No tests match' : 'Create your first test'} action={isAdmin && !list.filters.q ? <Link className="btn primary" to="/app/tests/new">New test</Link> : null}>
+            {list.filters.q || list.filters.status ? 'Try a different search or status.' : 'Add questions, publish it, and share the generated code with candidates.'}</Empty>
+        ) : (
+          <div className="table-wrap"><table className="t"><thead><tr><th>Test</th><th>Code</th><th>Status</th><th className="num">Questions</th><th className="num">Minutes</th><th className="num">Attempts</th><th>Window</th></tr></thead><tbody>
+            {list.items.map((t) => (
+              <tr key={t.id} className="click" onClick={() => nav(`/app/tests/${t.id}`)}>
+                <td><Link className="name" to={`/app/tests/${t.id}`} onClick={(e) => e.stopPropagation()}>{t.title}</Link>{t.has_password && <span className="sub"> · password</span>}{t.access_mode === 'invite' && <span className="sub"> · invite only</span>}</td>
+                <td onClick={(e) => e.stopPropagation()}><CodeTicket small code={t.code} display={t.code_display} /></td>
+                <td><Badge status={t.status} /></td>
+                <td className="num">{t.question_count}{t.coding_problem_count ? ` + ${t.coding_problem_count} coding` : ''}</td><td className="num">{t.duration_minutes}</td>
+                <td className="num">{t.attempts_total}{t.attempts.in_progress ? <span className="badge info" style={{ marginLeft: 6 }}>{t.attempts.in_progress} live</span> : null}</td>
+                <td className="muted">{t.start_time || t.end_time ? `${fmtDateTime(t.start_time)} → ${fmtDateTime(t.end_time)}` : 'Always open'}</td></tr>))}
+          </tbody></table></div>)}
+        <Pager page={list.page} pageSize={list.pageSize} total={list.total} onPage={list.setPage} />
+      </Panel>
+    </>
+  )
+}
diff --git a/frontend/src/pages/admin/test/Analytics.jsx b/frontend/src/pages/admin/test/Analytics.jsx
new file mode 100644
index 0000000..977cc86
--- /dev/null
+++ b/frontend/src/pages/admin/test/Analytics.jsx
@@ -0,0 +1,36 @@
+import { pct } from '../../../lib/format'
+import { Async, Empty, Panel, Stats, useLoad } from '../../../ui'
+import { api } from '../../../lib/api'
+import { BarChart, HBars, StackBar } from '../../../ui/charts'
+import { Link } from 'react-router-dom'
+
+export default function Analytics({ test: t }) {
+  const state = useLoad(() => api.get(`/tests/${t.id}/analytics`), [t.id])
+  return (
+    <Async state={state}>{(d) => {
+      const s = d.summary
+      if (!s.total_attempts) return <Panel><Empty title="No data yet">Analytics appear once candidates start submitting.</Empty></Panel>
+      return (
+        <>
+          <Stats items={[
+            { value: s.submitted, label: 'Submitted', sub: `${s.terminated} terminated · ${s.in_progress} in progress` },
+            { value: pct(s.average_percentage), label: 'Average score', sub: `Median ${pct(s.median_percentage)}` },
+            { value: pct(s.pass_rate), label: 'Pass rate', sub: `Pass mark ${d.test.pass_percentage}%` },
+            { value: s.average_time_minutes != null ? `${s.average_time_minutes} min` : '—', label: 'Average time' },
+            { value: s.average_risk ?? '—', label: 'Average risk' },
+          ]} />
+          <div className="grid c2" style={{ alignItems: 'start' }}>
+            <Panel title="Score distribution"><BarChart data={d.histogram.map((h) => ({ label: h.label.split('-')[0], value: h.count }))} format={(v) => `${v} candidate${v === 1 ? '' : 's'}`} /><p className="hint" style={{ textAlign: 'center' }}>Score band (% in steps of 10)</p></Panel>
+            <Panel title="Integrity risk"><StackBar parts={[{ label: 'Low', value: d.risk_distribution.low, color: 'var(--ok)' }, { label: 'Medium', value: d.risk_distribution.medium, color: 'var(--warn)' }, { label: 'High', value: d.risk_distribution.high, color: 'var(--bad)' }]} />
+              <h3 className="mt-lg" style={{ margin: '24px 0 8px' }}>Most common flags</h3>{d.violations_by_type.length ? <HBars items={d.violations_by_type.slice(0, 6).map((v) => ({ label: v.label, value: v.count }))} /> : <p className="muted">No flags raised.</p>}</Panel>
+          </div>
+          <Panel className="mt" title="Question difficulty (hardest first)" flush>
+            <div className="table-wrap"><table className="t"><thead><tr><th>Question</th><th className="num">Shown</th><th className="num">Correct</th><th style={{ width: 180 }}>Correct rate</th><th>Most common wrong answer</th></tr></thead><tbody>
+              {d.question_stats.map((q) => <tr key={q.question_id}><td style={{ maxWidth: 360 }}>{q.text}</td><td className="num">{q.shown}</td><td className="num">{q.correct}</td><td><HBars items={[{ label: '', value: q.correct_rate, color: q.correct_rate < 35 ? 'var(--bad)' : q.correct_rate < 70 ? 'var(--warn)' : 'var(--ok)' }]} max={100} format={(v) => `${v}%`} /></td><td className="muted">{q.most_common_wrong ?? '—'}</td></tr>)}
+            </tbody></table></div></Panel>
+          <Panel className="mt" title="Top scorers" flush><table className="t"><tbody>{d.leaderboard.map((l, i) => <tr key={l.attempt_id}><td className="num muted" style={{ width: 40 }}>{i + 1}</td><td><Link className="name" to={`/app/attempts/${l.attempt_id}`}>{l.name}</Link></td><td className="num">{l.score}/{l.max_score}</td><td className="num">{pct(l.percentage)}</td></tr>)}</tbody></table></Panel>
+        </>
+      )
+    }}</Async>
+  )
+}
diff --git a/frontend/src/pages/admin/test/Coding.jsx b/frontend/src/pages/admin/test/Coding.jsx
new file mode 100644
index 0000000..2cd07f9
--- /dev/null
+++ b/frontend/src/pages/admin/test/Coding.jsx
@@ -0,0 +1,67 @@
+import { useState } from 'react'
+import { Plus, Trash2 } from 'lucide-react'
+import { api } from '../../../lib/api'
+import { fmtDateTime } from '../../../lib/format'
+import { useAuth } from '../../../lib/auth'
+import { Alert, Async, Badge, Button, Check_, Empty, IconButton, Input, Modal, Panel, Tabs, Textarea, useLoad, useUI } from '../../../ui'
+
+const blank = () => ({ title: '', statement: '', input_format: '', output_format: '', constraints: '', points: 10, time_limit_seconds: 2, memory_limit_mb: 256, test_cases: [{ input_data: '', expected_output: '', is_sample: true }, { input_data: '', expected_output: '', is_sample: false }] })
+
+export default function Coding({ test: t, reload }) {
+  const { feature } = useAuth()
+  const { toast, error, confirm } = useUI()
+  const [tab, setTab] = useState('problems')
+  const problems = useLoad(() => api.get(`/tests/${t.id}/coding-problems`), [t.id])
+  const subs = useLoad(() => (tab === 'subs' ? api.get(`/tests/${t.id}/coding-submissions`) : Promise.resolve([])), [t.id, tab])
+  const [edit, setEdit] = useState(null)
+  if (!feature('coding_enabled')) return <Alert tone="warn">Coding questions are not included in your plan. Contact your account manager to enable them.</Alert>
+  return (
+    <>
+      <Alert tone="info">Candidate code runs in a Judge0 sandbox. If the platform owner has not connected Judge0, candidates see "execution service unavailable" when they run code.</Alert>
+      <Tabs active={tab} onChange={setTab} tabs={[{ id: 'problems', label: 'Problems', count: problems.data?.length }, { id: 'subs', label: 'Submissions' }]} />
+      {tab === 'problems' && <>
+        <div className="toolbar"><Button variant="primary" icon={Plus} onClick={() => setEdit(blank())}>Add problem</Button></div>
+        <Async state={problems}>{(rows) => !rows.length ? <Panel><Empty title="No coding problems">Add a problem with sample and hidden test cases. Candidates see samples only.</Empty></Panel> : rows.map((p) => (
+          <Panel key={p.id} title={p.title} actions={<><Badge>{p.points} pts</Badge><IconButton icon={Trash2} label="Delete problem" onClick={async () => { if (await confirm({ title: 'Delete this problem?', message: 'Past submissions for it are removed too.', confirmLabel: 'Delete', danger: true })) { try { await api.del(`/coding-problems/${p.id}`); problems.reload(); reload() } catch (e) { error(e) } } }} /></>}>
+            <p style={{ whiteSpace: 'pre-wrap' }}>{p.statement}</p>
+            <p className="muted mt" style={{ fontSize: 13 }}>{p.test_cases.length} test cases ({p.test_cases.filter((c) => c.is_sample).length} sample) · {p.time_limit_seconds}s · {p.memory_limit_mb} MB</p>
+          </Panel>))}</Async></>}
+      {tab === 'subs' && <Async state={subs}>{(rows) => !rows.length ? <Panel><Empty title="No submissions yet" /></Panel> : (
+        <Panel flush><div className="table-wrap"><table className="t"><thead><tr><th>Candidate</th><th>Problem</th><th>Language</th><th>Verdict</th><th className="num">Passed</th><th>When</th></tr></thead><tbody>
+          {rows.map((s) => <tr key={s.id}><td>{s.candidate_name}<div className="sub">{s.candidate_email}</div></td><td>{s.problem_title}</td><td>{s.language}</td><td><Badge tone={s.passed === s.total ? 'ok' : 'warn'}>{s.verdict}</Badge></td><td className="num">{s.passed}/{s.total}</td><td className="muted">{fmtDateTime(s.created_at)}</td></tr>)}
+        </tbody></table></div></Panel>)}</Async>}
+      {edit && <ProblemForm initial={edit} onClose={() => setEdit(null)} onSave={async (body) => { await api.post(`/tests/${t.id}/coding-problems`, body); toast('Problem added'); problems.reload(); reload() }} />}
+    </>
+  )
+}
+
+function ProblemForm({ initial, onClose, onSave }) {
+  const [p, setP] = useState(initial)
+  const [busy, setBusy] = useState(false)
+  const [err, setErr] = useState('')
+  const set = (k) => (e) => setP({ ...p, [k]: e.target.value })
+  const setCase = (i, k, v) => setP({ ...p, test_cases: p.test_cases.map((c, n) => (n === i ? { ...c, [k]: v } : c)) })
+  async function save() {
+    setBusy(true); setErr('')
+    const body = { ...p, points: Number(p.points), time_limit_seconds: Number(p.time_limit_seconds), memory_limit_mb: Number(p.memory_limit_mb) }
+    ;['input_format', 'output_format', 'constraints'].forEach((k) => !body[k] && delete body[k])
+    try { await onSave(body); onClose() } catch (e) { setErr(e.message); setBusy(false) }
+  }
+  return (
+    <Modal wide title="New coding problem" onClose={onClose} footer={<><Button onClick={onClose}>Cancel</Button><Button variant="primary" busy={busy} onClick={save}>Add problem</Button></>}>
+      {err && <Alert tone="bad">{err}</Alert>}
+      <Input label="Title" value={p.title} onChange={set('title')} />
+      <Textarea label="Problem statement" rows={5} value={p.statement} onChange={set('statement')} />
+      <div className="grid c2"><Textarea label="Input format" rows={2} value={p.input_format} onChange={set('input_format')} /><Textarea label="Output format" rows={2} value={p.output_format} onChange={set('output_format')} /></div>
+      <Input label="Constraints" value={p.constraints} onChange={set('constraints')} />
+      <div className="grid c3"><Input label="Points" type="number" min="1" value={p.points} onChange={set('points')} /><Input label="Time limit (s)" type="number" min="0.5" step="0.5" value={p.time_limit_seconds} onChange={set('time_limit_seconds')} /><Input label="Memory (MB)" type="number" min="32" value={p.memory_limit_mb} onChange={set('memory_limit_mb')} /></div>
+      <h3 className="mt">Test cases</h3><p className="hint mb">Sample cases are shown to candidates and used by "Run". Hidden cases only count when they submit.</p>
+      {p.test_cases.map((c, i) => (
+        <div key={i} className="panel" style={{ padding: 12, marginBottom: 10 }}>
+          <div className="grid c2"><Textarea label="Input" className="mono" rows={2} value={c.input_data} onChange={(e) => setCase(i, 'input_data', e.target.value)} /><Textarea label="Expected output" rows={2} value={c.expected_output} onChange={(e) => setCase(i, 'expected_output', e.target.value)} /></div>
+          <div className="row between"><Check_ label="Sample (visible to candidates)" checked={c.is_sample} onChange={(e) => setCase(i, 'is_sample', e.target.checked)} /><Button size="sm" disabled={p.test_cases.length <= 1} onClick={() => setP({ ...p, test_cases: p.test_cases.filter((_, n) => n !== i) })}>Remove</Button></div>
+        </div>))}
+      <Button size="sm" icon={Plus} onClick={() => setP({ ...p, test_cases: [...p.test_cases, { input_data: '', expected_output: '', is_sample: false }] })}>Add test case</Button>
+    </Modal>
+  )
+}
diff --git a/frontend/src/pages/admin/test/Invites.jsx b/frontend/src/pages/admin/test/Invites.jsx
new file mode 100644
index 0000000..177a86c
--- /dev/null
+++ b/frontend/src/pages/admin/test/Invites.jsx
@@ -0,0 +1,77 @@
+import { useRef, useState } from 'react'
+import { RotateCw, Send, Trash2, Upload } from 'lucide-react'
+import { api } from '../../../lib/api'
+import { ago, fmtDateTime } from '../../../lib/format'
+import { usePaged } from '../../../lib/hooks'
+import { Alert, Badge, Button, CopyButton, Empty, IconButton, Loading, Modal, Pager, Panel, Stats, Textarea, Check_, useUI } from '../../../ui'
+
+export default function Invites({ test: t }) {
+  const { toast, error, confirm } = useUI()
+  const list = usePaged(`/tests/${t.id}/invites`, { status: '' })
+  const [adding, setAdding] = useState(false)
+  const file = useRef(null)
+  const counts = list.data?.counts || {}
+
+  async function importCsv(f) {
+    if (!f) return
+    const fd = new FormData(); fd.append('file', f)
+    try { const r = await api.post(`/tests/${t.id}/invites/import-csv`, fd); toast(`${r.created.length} invited${r.skipped.length ? `, ${r.skipped.length} skipped` : ''}`); list.reload() } catch (e) { error(e) }
+    file.current.value = ''
+  }
+  return (
+    <>
+      {t.access_mode === 'invite' ? <Alert tone="info">This test is <b>invite only</b>: only the e-mail addresses below can join.</Alert> : <Alert tone="info">Anyone with the code can join. Invitations are optional: they e-mail a personal link and let you track who has not started.</Alert>}
+      {t.status === 'draft' && <Alert tone="warn">Publish the test before candidates try their links.</Alert>}
+      <Stats items={[{ value: counts.pending ?? 0, label: 'Waiting' }, { value: counts.started ?? 0, label: 'Started' }, { value: counts.completed ?? 0, label: 'Completed' }]} />
+      <div className="toolbar">
+        <Button variant="primary" icon={Send} onClick={() => setAdding(true)}>Invite candidates</Button>
+        <input ref={file} type="file" accept=".csv,text/csv" hidden onChange={(e) => importCsv(e.target.files[0])} />
+        <Button icon={Upload} onClick={() => file.current.click()}>Import CSV</Button>
+        <span className="muted" style={{ fontSize: 13 }}>CSV needs an <code>email</code> column and optionally <code>name</code>.</span>
+        <select className="input right" aria-label="Status" value={list.filters.status} onChange={(e) => list.setFilter('status', e.target.value)}><option value="">All</option>{['pending', 'started', 'completed', 'revoked'].map((s) => <option key={s} value={s}>{s[0].toUpperCase() + s.slice(1)}</option>)}</select>
+      </div>
+      <Panel flush>
+        {list.loading && !list.data ? <Loading /> : !list.items.length ? <Empty title="No invitations yet">Paste e-mail addresses to send each person their own link.</Empty> : (
+          <table className="t"><thead><tr><th>Candidate</th><th>Status</th><th>Sent</th><th>Expires</th><th /></tr></thead><tbody>
+            {list.items.map((i) => (
+              <tr key={i.id}><td><b>{i.name || i.email}</b>{i.name && <div className="sub">{i.email}</div>}</td><td><Badge status={i.status} /></td><td className="muted">{i.sent_at ? ago(i.sent_at) : 'Not e-mailed'}</td><td className="muted">{fmtDateTime(i.expires_at)}</td>
+                <td className="num nowrap"><CopyButton text={i.link} label="Copy link" />{' '}
+                  {i.status !== 'completed' && <IconButton icon={RotateCw} label="Resend invitation" onClick={async () => { try { await api.post(`/tests/${t.id}/invites/${i.id}/resend`); toast('Invitation sent again'); list.reload() } catch (e) { error(e) } }} />}
+                  {i.status !== 'revoked' && i.status !== 'completed' && <IconButton icon={Trash2} label="Revoke invitation" onClick={async () => { if (await confirm({ title: 'Revoke this invitation?', message: `${i.email} will no longer be able to use their personal link${t.access_mode === 'invite' ? ' or join at all' : ''}.`, confirmLabel: 'Revoke', danger: true })) { try { await api.del(`/tests/${t.id}/invites/${i.id}`); list.reload() } catch (e) { error(e) } } }} />}</td></tr>))}
+          </tbody></table>)}
+        <Pager page={list.page} pageSize={list.pageSize} total={list.total} onPage={list.setPage} />
+      </Panel>
+      {adding && <InviteModal testId={t.id} onClose={() => { setAdding(false); list.reload() }} />}
+    </>
+  )
+}
+
+function InviteModal({ testId, onClose }) {
+  const { error } = useUI()
+  const [text, setText] = useState('')
+  const [send, setSend] = useState(true)
+  const [busy, setBusy] = useState(false)
+  const [done, setDone] = useState(null)
+  const parsed = text.split(/\n/).map((l) => l.trim()).filter(Boolean).map((l) => {
+    const m = l.match(/^(.*?)[,;\t ]+([^\s,;]+@[^\s,;]+)$/) || l.match(/^()([^\s,;]+@[^\s,;]+)$/) || l.match(/^([^\s,;]+@[^\s,;]+)[,;\t ]+(.+)$/)
+    if (!m) return null
+    const [a, b] = [m[1].trim(), m[2].trim()]
+    return a.includes('@') ? { email: a, name: b || undefined } : { email: b, name: a || undefined }
+  })
+  const valid = parsed.filter(Boolean)
+  async function go() {
+    setBusy(true)
+    try { setDone(await api.post(`/tests/${testId}/invites`, { invitees: valid, send_email: send })) } catch (e) { error(e) } finally { setBusy(false) }
+  }
+  if (done) return <Modal title="Invitations created" onClose={onClose} footer={<Button variant="primary" onClick={onClose}>Done</Button>}>
+    <Alert tone="ok">{done.created.length} invitation{done.created.length === 1 ? '' : 's'} created{send ? ' and queued for e-mail' : ''}.</Alert>
+    {done.skipped.length > 0 && <Alert tone="warn">Skipped: {done.skipped.map((s) => (typeof s === 'string' ? s : `${s.email} (${s.reason})`)).join(', ')}</Alert>}
+    {done.note && <Alert tone="info">{done.note}</Alert>}</Modal>
+  return (
+    <Modal wide title="Invite candidates" onClose={onClose} footer={<><Button onClick={onClose}>Cancel</Button><Button variant="primary" disabled={!valid.length} busy={busy} onClick={go}>Create {valid.length || ''} invitation{valid.length === 1 ? '' : 's'}</Button></>}>
+      <Textarea label="One person per line" rows={8} value={text} onChange={(e) => setText(e.target.value)} placeholder={'asha@example.com\nRavi Kumar, ravi@example.com'} hint="Either “name, email” or just the email." />
+      {text && parsed.some((p) => !p) && <Alert tone="warn">{parsed.filter((p) => !p).length} line(s) have no valid e-mail and will be ignored.</Alert>}
+      <Check_ label="E-mail each person their link now" hint="Without SMTP the message is stored in the platform outbox and you can copy links manually." checked={send} onChange={(e) => setSend(e.target.checked)} />
+    </Modal>
+  )
+}
diff --git a/frontend/src/pages/admin/test/Live.jsx b/frontend/src/pages/admin/test/Live.jsx
new file mode 100644
index 0000000..afafe0d
--- /dev/null
+++ b/frontend/src/pages/admin/test/Live.jsx
@@ -0,0 +1,56 @@
+import { useState } from 'react'
+import { Link } from 'react-router-dom'
+import { MessageSquare, Clock, Power } from 'lucide-react'
+import { api } from '../../../lib/api'
+import { clock } from '../../../lib/format'
+import { usePoll } from '../../../lib/hooks'
+import { Async, Badge, Button, Empty, Modal, Panel, RiskMeter, Stats, Textarea, Input, useLoad, useUI } from '../../../ui'
+
+export default function Live({ test: t }) {
+  const { toast, error, confirm } = useUI()
+  const state = useLoad(() => api.get(`/tests/${t.id}/live`), [t.id])
+  usePoll(() => state.reload(), 5000)
+  const [dlg, setDlg] = useState(null)
+
+  const call = async (fn, msg) => { try { await fn(); toast(msg); state.reload() } catch (e) { error(e) } }
+  return (
+    <Async state={state}>{(d) => (
+      <>
+        <Stats items={[{ value: d.summary.in_progress, label: 'Taking the test' }, { value: d.summary.in_lobby, label: 'In the lobby' }, { value: d.summary.offline, label: 'Offline', sub: 'No signal for 30 s' }, { value: d.summary.high_risk, label: 'High risk' }]} />
+        <p className="muted mb" style={{ fontSize: 13 }}>Updates every 5 seconds while this tab is open.</p>
+        <Panel flush>
+          {!d.items.length ? <Empty title="Nobody is in the test right now">Candidates appear here when they join with the code.</Empty> : (
+            <div className="table-wrap"><table className="t"><thead><tr><th>Candidate</th><th>Status</th><th className="num">Progress</th><th className="num">Time left</th><th>Risk</th><th>Last flag</th><th /></tr></thead><tbody>
+              {d.items.map((a) => (
+                <tr key={a.id}>
+                  <td><Link className="name" to={`/app/attempts/${a.id}`}>{a.candidate.name}</Link><div className="sub">{a.candidate.email}</div></td>
+                  <td>{a.status === 'registered' ? <Badge status="registered" /> : a.online ? <Badge tone="ok" ><i className="dot live" />Online</Badge> : <Badge tone="warn">Offline {a.seconds_since_heartbeat != null ? `${a.seconds_since_heartbeat}s` : ''}</Badge>}</td>
+                  <td className="num">{a.status === 'registered' ? '—' : `${a.answered}/${a.total_questions}`}</td>
+                  <td className="num">{a.remaining_seconds != null ? clock(a.remaining_seconds) : '—'}</td>
+                  <td><RiskMeter score={a.risk_score} level={a.risk_level} /><div className="sub">{a.level2_count} serious</div></td>
+                  <td className="sub" style={{ maxWidth: 220 }}>{a.last_violation ? a.last_violation.label : '—'}</td>
+                  <td className="num nowrap">{a.status === 'in_progress' && <>
+                    <Button size="sm" icon={MessageSquare} onClick={() => setDlg({ kind: 'message', a })}>Message</Button>{' '}
+                    <Button size="sm" icon={Clock} onClick={() => setDlg({ kind: 'extend', a })}>Add time</Button>{' '}
+                    <Button size="sm" icon={Power} onClick={async () => { if (await confirm({ title: `End ${a.candidate.name}'s attempt?`, message: 'Their answers so far are submitted and scored, and the attempt is marked terminated.', confirmLabel: 'End attempt', danger: true })) setDlg({ kind: 'terminate', a }) }}>End</Button></>}</td></tr>))}
+            </tbody></table></div>)}
+        </Panel>
+        {dlg?.kind === 'message' && <TextDialog title={`Message ${dlg.a.candidate.name}`} label="Message" cta="Send message" onClose={() => setDlg(null)} onSubmit={(v) => call(() => api.post(`/attempts/${dlg.a.id}/message`, { body: v }), 'Message sent')} />}
+        {dlg?.kind === 'terminate' && <TextDialog title="Reason for ending" label="Reason (recorded and shown to the candidate)" cta="End attempt" danger onClose={() => setDlg(null)} onSubmit={(v) => call(() => api.post(`/attempts/${dlg.a.id}/terminate`, { reason: v }), 'Attempt ended')} />}
+        {dlg?.kind === 'extend' && <ExtendDialog onClose={() => setDlg(null)} onSubmit={(m) => call(() => api.post(`/attempts/${dlg.a.id}/extend`, { minutes: m }), `Added ${m} minutes`)} />}
+      </>
+    )}</Async>
+  )
+}
+
+export function TextDialog({ title, label, cta, danger, onClose, onSubmit }) {
+  const [v, setV] = useState('')
+  const [busy, setBusy] = useState(false)
+  return <Modal title={title} onClose={onClose} footer={<><Button onClick={onClose}>Cancel</Button><Button variant={danger ? 'danger' : 'primary'} busy={busy} disabled={!v.trim()} onClick={async () => { setBusy(true); await onSubmit(v.trim()); onClose() }}>{cta}</Button></>}>
+    <Textarea label={label} rows={3} value={v} onChange={(e) => setV(e.target.value)} maxLength={500} /></Modal>
+}
+function ExtendDialog({ onClose, onSubmit }) {
+  const [m, setM] = useState(10)
+  return <Modal title="Add time" onClose={onClose} footer={<><Button onClick={onClose}>Cancel</Button><Button variant="primary" onClick={async () => { await onSubmit(Number(m)); onClose() }}>Add {m} minutes</Button></>}>
+    <Input label="Minutes to add" type="number" min="1" max="240" value={m} onChange={(e) => setM(e.target.value)} hint="The candidate is notified automatically." /></Modal>
+}
diff --git a/frontend/src/pages/admin/test/Overview.jsx b/frontend/src/pages/admin/test/Overview.jsx
new file mode 100644
index 0000000..ad1b842
--- /dev/null
+++ b/frontend/src/pages/admin/test/Overview.jsx
@@ -0,0 +1,47 @@
+import { Link } from 'react-router-dom'
+import { Check, Circle } from 'lucide-react'
+import { fmtDateTime } from '../../../lib/format'
+import { Alert, CopyButton, Panel, Stats } from '../../../ui'
+
+export default function Overview({ test: t, isAdmin }) {
+  const hasContent = t.question_count + t.coding_problem_count > 0
+  const steps = [
+    { done: hasContent, text: 'Add questions or coding problems', to: 'questions' },
+    { done: !!t.instructions, text: 'Write instructions for candidates (optional)', to: 'settings', optional: true },
+    { done: t.status !== 'draft', text: 'Publish the test', to: null },
+    { done: t.attempts_total > 0, text: 'Share the code or send invitations', to: 'invites' },
+  ]
+  const share = `Your test "${t.title}" is open. Go to ${t.join_url} or enter the code ${t.code_display} at ${window.location.origin}.\nDuration: ${t.duration_minutes} minutes.${t.end_time ? `\nStart before ${fmtDateTime(t.end_time)}.` : ''}`
+  return (
+    <>
+      <Stats items={[
+        { value: t.attempts.registered, label: 'In lobby' }, { value: t.attempts.in_progress, label: 'Taking it now' },
+        { value: t.attempts.submitted, label: 'Submitted' }, { value: t.attempts.terminated, label: 'Terminated' }, { value: t.total_marks, label: 'Total marks', sub: `Pass at ${t.pass_percentage}%` },
+      ]} />
+      {t.status === 'draft' && <Alert tone="info">This test is a draft. Candidates cannot join until you publish it.</Alert>}
+      <div className="grid c2" style={{ alignItems: 'start' }}>
+        {isAdmin && t.status === 'draft' && (
+          <Panel title="Before you publish"><ul style={{ listStyle: 'none', padding: 0, margin: 0, display: 'grid', gap: 12 }}>
+            {steps.map((s) => <li key={s.text} className="row" style={{ alignItems: 'flex-start' }}>{s.done ? <Check size={18} color="var(--ok)" /> : <Circle size={18} color="var(--line-strong)" />}<span style={{ color: s.done ? 'var(--text-3)' : undefined }}>{s.to && !s.done ? <Link to={`/app/tests/${t.id}/${s.to}`}>{s.text}</Link> : s.text}</span></li>)}
+          </ul></Panel>
+        )}
+        <Panel title="How candidates get in" actions={<CopyButton text={share} label="Copy message" />}>
+          <dl className="kv">
+            <dt>Test code</dt><dd><code style={{ fontSize: '1.05rem', letterSpacing: '0.12em' }}>{t.code_display}</code></dd>
+            <dt>Direct link</dt><dd><a href={t.join_url}>{t.join_url}</a></dd>
+            <dt>Access</dt><dd>{t.access_mode === 'invite' ? 'Invite only — only invited e-mail addresses can join' : 'Anyone with the code'}{t.has_password ? ' + access password' : ''}</dd>
+            <dt>Available</dt><dd>{t.start_time || t.end_time ? `${fmtDateTime(t.start_time)} → ${fmtDateTime(t.end_time)}` : 'Whenever the test is published'}</dd>
+            <dt>Duration</dt><dd>{t.duration_minutes} minutes{t.questions_per_attempt ? ` · ${t.questions_per_attempt} questions drawn per candidate` : ''}</dd>
+          </dl>
+        </Panel>
+        <Panel title="Proctoring">
+          <div className="chips">
+            {[['webcam_required', 'Webcam'], ['microphone_required', 'Microphone'], ['fullscreen_required', 'Fullscreen'], ['ai_monitoring', 'AI face checks'], ['id_verification', 'ID check'], ['detect_tab_switch', 'Tab-switch alerts'], ['block_copy_paste', 'Copy/paste blocked'], ['auto_terminate', `Auto-end after ${t.proctoring.max_level2_violations} serious flags`]].filter(([k]) => t.proctoring[k]).map(([k, l]) => <span className="chip" key={k}>{l}</span>)}
+            {!Object.values(t.proctoring).some(Boolean) && <span className="muted">No proctoring enabled.</span>}
+          </div>
+          {isAdmin && <p className="mt" style={{ fontSize: 13 }}><Link to={`/app/tests/${t.id}/settings`}>Change proctoring settings</Link></p>}
+        </Panel>
+      </div>
+    </>
+  )
+}
diff --git a/frontend/src/pages/admin/test/Questions.jsx b/frontend/src/pages/admin/test/Questions.jsx
new file mode 100644
index 0000000..4f073bd
--- /dev/null
+++ b/frontend/src/pages/admin/test/Questions.jsx
@@ -0,0 +1,112 @@
+import { useRef, useState } from 'react'
+import { ArrowDown, ArrowUp, BookOpen, BookmarkPlus, Download, Pencil, Plus, Trash2, Upload } from 'lucide-react'
+import { api } from '../../../lib/api'
+import { Alert, Badge, Button, Empty, IconButton, Loading, Modal, Panel, SearchBox, useLoad, useUI } from '../../../ui'
+import QuestionEditor, { TYPE_LABEL } from '../QuestionEditor'
+import { usePaged } from '../../../lib/hooks'
+
+export default function Questions({ test: t, reload, isAdmin }) {
+  const { toast, error, confirm } = useUI()
+  const state = useLoad(() => api.get(`/tests/${t.id}`), [t.id, t.question_count])
+  const [editor, setEditor] = useState(null)
+  const [csv, setCsv] = useState(false)
+  const [bank, setBank] = useState(false)
+  const questions = state.data?.questions || []
+  const sections = [...new Set(questions.map((q) => q.section).filter(Boolean))]
+  const locked = t.status === 'archived'
+  const refresh = () => { state.reload(); reload() }
+
+  async function move(i, dir) {
+    const ids = questions.map((q) => q.id); const j = i + dir
+    if (j < 0 || j >= ids.length) return
+    ;[ids[i], ids[j]] = [ids[j], ids[i]]
+    try { await api.post(`/tests/${t.id}/questions/reorder`, { ids }); state.reload() } catch (e) { error(e) }
+  }
+  const remove = async (q) => {
+    if (!(await confirm({ title: 'Delete question?', message: 'Candidates who already started keep their copy; new candidates will not see it.', confirmLabel: 'Delete', danger: true }))) return
+    try { await api.del(`/tests/${t.id}/questions/${q.id}`); refresh() } catch (e) { error(e) }
+  }
+
+  if (state.loading && !state.data) return <Loading />
+  return (
+    <>
+      {isAdmin && !locked && (
+        <div className="toolbar">
+          <Button variant="primary" icon={Plus} onClick={() => setEditor({})}>Add question</Button>
+          <Button icon={BookOpen} onClick={() => setBank(true)}>From question bank</Button>
+          <Button icon={Upload} onClick={() => setCsv(true)}>Import CSV</Button>
+          <span className="right muted" style={{ fontSize: 13 }}>{questions.length} question{questions.length === 1 ? '' : 's'} · {t.total_marks} marks</span>
+        </div>
+      )}
+      {!questions.length ? <Panel><Empty title="No questions yet" action={isAdmin && <Button variant="primary" icon={Plus} onClick={() => setEditor({})}>Add the first question</Button>}>Write questions one by one, pull them from your question bank, or import many from a CSV file.</Empty></Panel> : (
+        <Panel flush><ol style={{ listStyle: 'none', margin: 0, padding: 0 }}>
+          {questions.map((q, i) => (
+            <li key={q.id} style={{ padding: '14px 18px', borderTop: i ? '1px solid var(--line)' : 0, display: 'grid', gridTemplateColumns: '28px 1fr auto', gap: 12 }}>
+              <span className="muted" style={{ fontVariantNumeric: 'tabular-nums', paddingTop: 2 }}>{i + 1}.</span>
+              <div style={{ minWidth: 0 }}>
+                <div style={{ whiteSpace: 'pre-wrap' }}>{q.question_text}</div>
+                {q.options?.length > 0 && isAdmin && <ul style={{ margin: '8px 0 0', paddingLeft: 18 }}>{q.options.map((o, k) => <li key={k} style={{ color: q.correct.includes(k) ? 'var(--ok)' : 'var(--text-2)', fontWeight: q.correct.includes(k) ? 600 : 400 }}>{o}</li>)}</ul>}
+                {q.question_type === 'short_text' && isAdmin && <div className="muted-2" style={{ marginTop: 6 }}>Accepts: {q.correct.join(' · ')}</div>}
+                <div className="chips mt" style={{ marginTop: 10 }}>
+                  <Badge tone="info">{TYPE_LABEL[q.question_type]}</Badge><Badge>{q.marks} mark{q.marks === 1 ? '' : 's'}</Badge>{q.negative_marks > 0 && <Badge tone="bad">−{q.negative_marks}</Badge>}
+                  {q.section && <Badge>{q.section}</Badge>}<Badge>{q.difficulty}</Badge>{q.tags.map((x) => <Badge key={x}>#{x}</Badge>)}
+                </div>
+              </div>
+              {isAdmin && !locked && <div className="row" style={{ alignSelf: 'start', gap: 2 }}>
+                <IconButton icon={ArrowUp} label="Move up" disabled={i === 0} onClick={() => move(i, -1)} /><IconButton icon={ArrowDown} label="Move down" disabled={i === questions.length - 1} onClick={() => move(i, 1)} />
+                <IconButton icon={Pencil} label="Edit" onClick={() => setEditor(q)} />
+                <IconButton icon={BookmarkPlus} label="Save to question bank" onClick={async () => { try { await api.post(`/tests/${t.id}/questions/${q.id}/save-to-bank`); toast('Saved to the question bank') } catch (e) { error(e) } }} />
+                <IconButton icon={Trash2} label="Delete" onClick={() => remove(q)} /></div>}
+            </li>))}
+        </ol></Panel>
+      )}
+      {editor && <QuestionEditor initial={editor.id ? editor : undefined} sections={sections} onClose={() => setEditor(null)}
+        onSave={async (body) => { editor.id ? await api.put(`/tests/${t.id}/questions/${editor.id}`, body) : await api.post(`/tests/${t.id}/questions`, body); toast('Question saved'); refresh() }} />}
+      {csv && <CsvImport testId={t.id} onClose={() => { setCsv(false); refresh() }} />}
+      {bank && <BankPicker testId={t.id} onClose={() => { setBank(false); refresh() }} />}
+    </>
+  )
+}
+
+function CsvImport({ testId, onClose }) {
+  const { error, toast } = useUI()
+  const [file, setFile] = useState(null)
+  const [result, setResult] = useState(null)
+  const [busy, setBusy] = useState(false)
+  const input = useRef(null)
+  async function send(dry) {
+    setBusy(true)
+    const fd = new FormData(); fd.append('file', file); fd.append('dry_run', dry ? 'true' : 'false')
+    try { const r = await api.post(`/tests/${testId}/questions/import-csv`, fd); setResult({ ...r, dry }); if (!dry && !r.errors.length) { toast(`${r.imported} questions imported`); onClose() } } catch (e) { error(e) } finally { setBusy(false) }
+  }
+  return (
+    <Modal wide title="Import questions from CSV" onClose={onClose} footer={<><Button onClick={onClose}>Close</Button><Button onClick={() => send(true)} disabled={!file} busy={busy}>Check file</Button><Button variant="primary" onClick={() => send(false)} disabled={!file || (result?.errors?.length > 0)} busy={busy}>Import</Button></>}>
+      <p className="muted-2 mb">Columns: question_type, question_text, option_a…option_h, correct, marks, negative_marks, section, difficulty, tags, explanation. Either every row is imported or none is.</p>
+      <div className="row mb"><Button icon={Download} onClick={() => api.download('/tests/questions-template.csv', 'questions-template.csv').catch(error)}>Download template</Button>
+        <input ref={input} type="file" accept=".csv,text/csv" hidden onChange={(e) => { setFile(e.target.files[0]); setResult(null) }} />
+        <Button icon={Upload} onClick={() => input.current.click()}>{file ? file.name : 'Choose CSV file'}</Button></div>
+      {result?.errors?.length > 0 && <Alert tone="bad"><b>{result.errors.length} problem{result.errors.length > 1 ? 's' : ''} found — nothing was imported.</b><ul style={{ margin: '6px 0 0', paddingLeft: 18 }}>{result.errors.slice(0, 30).map((e, i) => <li key={i}>{typeof e === 'string' ? e : `Row ${e.row}: ${e.error || e.message}`}</li>)}</ul></Alert>}
+      {result && !result.errors?.length && result.dry && <Alert tone="ok">{result.valid_rows} valid question{result.valid_rows === 1 ? '' : 's'}. Press Import to add them.</Alert>}
+    </Modal>
+  )
+}
+
+function BankPicker({ testId, onClose }) {
+  const { error, toast } = useUI()
+  const list = usePaged('/bank/questions', { q: '', difficulty: '', question_type: '' }, { pageSize: 50 })
+  const [picked, setPicked] = useState(new Set())
+  const [busy, setBusy] = useState(false)
+  const toggle = (id) => setPicked((s) => { const n = new Set(s); n.has(id) ? n.delete(id) : n.add(id); return n })
+  async function add() {
+    setBusy(true)
+    try { const r = await api.post(`/tests/${testId}/questions/from-bank`, { question_ids: [...picked] }); toast(`${r.added ?? picked.size} question${picked.size === 1 ? '' : 's'} added`); onClose() } catch (e) { error(e); setBusy(false) }
+  }
+  return (
+    <Modal wide title="Add from question bank" onClose={onClose} footer={<><Button onClick={onClose}>Cancel</Button><Button variant="primary" disabled={!picked.size} busy={busy} onClick={add}>Add {picked.size || ''} selected</Button></>}>
+      <div className="toolbar"><SearchBox value={list.filters.q} onChange={(v) => list.setFilter('q', v)} placeholder="Search the bank" />
+        <select className="input" aria-label="Difficulty" value={list.filters.difficulty} onChange={(e) => list.setFilter('difficulty', e.target.value)}><option value="">Any difficulty</option><option>easy</option><option>medium</option><option>hard</option></select></div>
+      {list.loading && !list.data ? <Loading /> : !list.items.length ? <Empty title="The bank is empty">Save questions to the bank from any test, or add them under Question bank.</Empty> : (
+        <div style={{ display: 'grid', gap: 2 }}>{list.items.map((q) => <label key={q.id} className="check" style={{ padding: '9px 6px', borderBottom: '1px solid var(--line)' }}><input type="checkbox" checked={picked.has(q.id)} onChange={() => toggle(q.id)} /><span>{q.question_text}<small>{TYPE_LABEL[q.question_type]} · {q.marks} mark{q.marks === 1 ? '' : 's'} · {q.difficulty}{q.section ? ` · ${q.section}` : ''}</small></span></label>)}</div>)}
+    </Modal>
+  )
+}
diff --git a/frontend/src/pages/admin/test/Results.jsx b/frontend/src/pages/admin/test/Results.jsx
