+  }
+  useEffect(() => { if (!needGate) setReady(true) }, []) // eslint-disable-line
+
+  const q = questions[idx]
+  const setAnswer = (id, v) => setAnswers((a) => { const n = { ...a }; if (v === '' || v == null || (Array.isArray(v) && !v.length)) delete n[id]; else n[id] = v; return n })
