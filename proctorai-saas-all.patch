@@ -0,0 +1,46 @@
+import { Link } from 'react-router-dom'
+import { api } from '../../lib/api'
+import { money, fmtDate } from '../../lib/format'
+import { useDocumentTitle } from '../../lib/hooks'
+import { Alert, Async, PageHeader, Panel, Stats, useLoad } from '../../ui'
+import { LineChart, HBars, StackBar } from '../../ui/charts'
+
+export default function Overview() {
+  useDocumentTitle('Platform overview')
+  const state = useLoad(() => api.get('/superadmin/overview'), [])
+  return (
+    <>
+      <PageHeader title="Platform overview" subtitle="Every client organization at a glance." />
+      <Async state={state}>{(d) => {
+        const o = d.organizations
+        const mrr = Object.entries(d.mrr || {}).map(([c, v]) => money(v, c)).join(' + ') || money(0)
+        return (
+          <>
+            {d.new_demo_requests > 0 && <Alert tone="info"><Link to="/super/leads">{d.new_demo_requests} new demo request{d.new_demo_requests > 1 ? 's' : ''}</Link> waiting for a reply.</Alert>}
+            <Stats items={[
+              { value: o.total, label: 'Organizations', sub: `${o.active} active · ${o.trial} on trial` },
+              { value: mrr, label: 'Monthly recurring', sub: 'From active plans (manual billing)' },
+              { value: d.attempts.this_month, label: 'Attempts this month', sub: `${d.attempts.in_progress_now} in progress now` },
+              { value: d.candidates, label: 'Candidates', sub: `${d.tests.published} of ${d.tests.total} tests published` },
+            ]} />
+            <div className="grid c2" style={{ alignItems: 'start' }}>
+              <Panel title="Attempts, last 30 days"><LineChart data={d.attempts_last_30_days.map((x) => ({ label: x.date.slice(5), value: x.attempts }))} /></Panel>
+              <Panel title="Organization status"><StackBar parts={[
+                { label: 'Active', value: o.active, color: 'var(--ok)' }, { label: 'Trial', value: o.trial, color: 'var(--info)' },
+                { label: 'Suspended', value: o.suspended, color: 'var(--warn)' }, { label: 'Cancelled', value: o.cancelled, color: 'var(--bad)' }]} /></Panel>
+            </div>
+            <div className="grid c2 mt" style={{ alignItems: 'start' }}>
+              <Panel title="Busiest organizations (30 days)">
+                {d.top_organizations.length ? <HBars items={d.top_organizations.map((t) => ({ label: t.name, value: t.attempts }))} /> : <p className="muted">No activity yet.</p>}
+              </Panel>
+              <Panel title="Trials ending soon">
+                {d.trials_ending_soon.length ? <table className="t"><tbody>{d.trials_ending_soon.map((t) => (
+                  <tr key={t.id}><td><Link className="name" to={`/super/organizations/${t.id}`}>{t.name}</Link></td><td className="num muted">{fmtDate(t.trial_ends_at)}</td></tr>))}</tbody></table> : <p className="muted">None in the next 7 days.</p>}
+              </Panel>
+            </div>
+          </>
+        )
+      }}</Async>
+    </>
+  )
+}
diff --git a/frontend/src/pages/super/Plans.jsx b/frontend/src/pages/super/Plans.jsx
new file mode 100644
index 0000000..590ff9f
--- /dev/null
+++ b/frontend/src/pages/super/Plans.jsx
@@ -0,0 +1,61 @@
+import { useState } from 'react'
+import { Plus } from 'lucide-react'
+import { api } from '../../lib/api'
+import { limitText, money } from '../../lib/format'
+import { useDocumentTitle } from '../../lib/hooks'
+import { Async, Badge, Button, Check_, Input, Modal, PageHeader, Panel, Textarea, useLoad, useUI } from '../../ui'
+
+const EMPTY = { code: '', name: '', description: '', price_monthly: 0, currency: 'USD', max_admins: 3, max_active_tests: 3, max_candidates_per_month: 50, evidence_retention_days: 30, ai_proctoring: true, coding_enabled: true, api_access: false, webhooks_enabled: false, is_public: true, is_active: true, sort_order: 0 }
+
+export default function Plans() {
+  useDocumentTitle('Plans')
+  const { toast, error, confirm } = useUI()
+  const state = useLoad(() => api.get('/superadmin/plans'), [])
+  const [editing, setEditing] = useState(null)
+  return (
+    <>
+      <PageHeader title="Plans" subtitle="What each tier includes. Changing a plan changes every organization on it."><Button variant="primary" icon={Plus} onClick={() => setEditing({ ...EMPTY })}>New plan</Button></PageHeader>
+      <Async state={state}>{(plans) => (
+        <Panel flush><div className="table-wrap"><table className="t">
+          <thead><tr><th>Plan</th><th className="num">Price</th><th className="num">Seats</th><th className="num">Tests</th><th className="num">Candidates/mo</th><th>Features</th><th className="num">Orgs</th><th /></tr></thead>
+          <tbody>{plans.map((p) => (
+            <tr key={p.id}><td><b>{p.name}</b> {!p.is_active && <Badge>Retired</Badge>} {!p.is_public && <Badge tone="info">Hidden</Badge>}<div className="sub"><code>{p.code}</code></div></td>
+              <td className="num">{p.price_monthly ? money(p.price_monthly, p.currency) : 'Free'}</td><td className="num">{limitText(p.max_admins)}</td><td className="num">{limitText(p.max_active_tests)}</td><td className="num">{limitText(p.max_candidates_per_month)}</td>
+              <td className="sub">{[p.ai_proctoring && 'AI', p.coding_enabled && 'Coding', p.api_access && 'API', p.webhooks_enabled && 'Webhooks'].filter(Boolean).join(', ') || '—'}</td>
+              <td className="num">{p.organizations}</td>
+              <td className="num nowrap"><Button size="sm" onClick={() => setEditing(p)}>Edit</Button>{' '}
+                <Button size="sm" disabled={p.organizations > 0} title={p.organizations ? 'Move its organizations to another plan first' : ''} onClick={async () => { if (await confirm({ title: `Delete ${p.name}?`, message: 'This cannot be undone.', confirmLabel: 'Delete plan', danger: true })) { try { await api.del(`/superadmin/plans/${p.id}`); toast('Plan deleted'); state.reload() } catch (e) { error(e) } } }}>Delete</Button></td></tr>))}</tbody></table></div></Panel>
+      )}</Async>
+      {editing && <PlanEditor plan={editing} onClose={() => setEditing(null)} onSaved={() => { setEditing(null); state.reload() }} />}
+    </>
+  )
+}
+
+function PlanEditor({ plan, onClose, onSaved }) {
+  const { toast, error } = useUI()
+  const isNew = !plan.id
+  const [f, setF] = useState(plan)
+  const [busy, setBusy] = useState(false)
+  const set = (k) => (e) => setF({ ...f, [k]: e.target.value })
+  const n = (k) => (e) => setF({ ...f, [k]: e.target.value === '' ? '' : Number(e.target.value) })
+  const b = (k) => (e) => setF({ ...f, [k]: e.target.checked })
+  async function save() {
+    setBusy(true)
+    const body = { ...f }; ['id', 'organizations'].forEach((k) => delete body[k])
+    try { isNew ? await api.post('/superadmin/plans', body) : await api.put(`/superadmin/plans/${plan.id}`, body); toast('Plan saved'); onSaved() } catch (e) { error(e) } finally { setBusy(false) }
+  }
+  return (
+    <Modal wide title={isNew ? 'New plan' : `Edit ${plan.name}`} onClose={onClose} footer={<><Button onClick={onClose}>Cancel</Button><Button variant="primary" busy={busy} onClick={save}>Save plan</Button></>}>
+      <div className="grid c2"><Input label="Name" value={f.name} onChange={set('name')} /><Input label="Code" value={f.code} onChange={set('code')} disabled={!isNew} hint="Lowercase letters, numbers, - and _. Cannot change later." /></div>
+      <Textarea label="Description" value={f.description || ''} onChange={set('description')} />
+      <div className="grid c3"><Input label="Price per month" type="number" min="0" value={f.price_monthly} onChange={n('price_monthly')} /><Input label="Currency" maxLength={3} value={f.currency} onChange={set('currency')} /><Input label="Sort order" type="number" value={f.sort_order} onChange={n('sort_order')} /></div>
+      <div className="grid c4"><Input label="Team seats" type="number" min="-1" value={f.max_admins} onChange={n('max_admins')} /><Input label="Active tests" type="number" min="-1" value={f.max_active_tests} onChange={n('max_active_tests')} /><Input label="Candidates / month" type="number" min="-1" value={f.max_candidates_per_month} onChange={n('max_candidates_per_month')} /><Input label="Evidence days" type="number" min="1" value={f.evidence_retention_days} onChange={n('evidence_retention_days')} /></div>
+      <p className="hint mb">-1 means unlimited.</p>
+      <div className="grid c2">
+        <Check_ label="AI proctoring" checked={f.ai_proctoring} onChange={b('ai_proctoring')} /><Check_ label="Coding questions" checked={f.coding_enabled} onChange={b('coding_enabled')} />
+        <Check_ label="API access" checked={f.api_access} onChange={b('api_access')} /><Check_ label="Webhooks" checked={f.webhooks_enabled} onChange={b('webhooks_enabled')} />
+        <Check_ label="Shown on the public pricing page" checked={f.is_public} onChange={b('is_public')} /><Check_ label="Available for new organizations" checked={f.is_active} onChange={b('is_active')} />
+      </div>
+    </Modal>
+  )
+}
diff --git a/frontend/src/pages/super/PlatformAdmins.jsx b/frontend/src/pages/super/PlatformAdmins.jsx
new file mode 100644
index 0000000..fbcae24
--- /dev/null
+++ b/frontend/src/pages/super/PlatformAdmins.jsx
@@ -0,0 +1,40 @@
+import { useState } from 'react'
+import { Plus } from 'lucide-react'
+import { api } from '../../lib/api'
+import { fmtDateTime } from '../../lib/format'
+import { useAuth } from '../../lib/auth'
+import { useDocumentTitle } from '../../lib/hooks'
+import { Alert, Async, Badge, Button, CopyButton, Input, Modal, PageHeader, Panel, useLoad, useUI } from '../../ui'
+
+export default function PlatformAdmins() {
+  useDocumentTitle('Platform admins')
+  const { user: me } = useAuth()
+  const { error } = useUI()
+  const state = useLoad(() => api.get('/superadmin/platform-admins'), [])
+  const [adding, setAdding] = useState(false)
+  return (
+    <>
+      <PageHeader title="Platform admins" subtitle="People with full control of the platform and every organization."><Button variant="primary" icon={Plus} onClick={() => setAdding(true)}>Add platform admin</Button></PageHeader>
+      <Async state={state}>{(rows) => (
+        <Panel flush><table className="t"><thead><tr><th>Name</th><th>Status</th><th>Last sign-in</th><th /></tr></thead><tbody>
+          {rows.map((u) => <tr key={u.id}><td><b>{u.full_name}</b> {u.id === me.id && <Badge tone="info">You</Badge>}<div className="sub">{u.email}</div></td><td>{u.is_active ? <Badge status="active" /> : <Badge status="suspended">Disabled</Badge>}</td><td className="muted">{fmtDateTime(u.last_login_at)}</td>
+            <td className="num">{u.id !== me.id && <Button size="sm" onClick={async () => { try { await api.patch(`/superadmin/platform-admins/${u.id}`, { is_active: !u.is_active }); state.reload() } catch (e) { error(e) } }}>{u.is_active ? 'Disable' : 'Enable'}</Button>}</td></tr>)}
+        </tbody></table></Panel>
+      )}</Async>
+      {adding && <Add onClose={() => { setAdding(false); state.reload() }} />}
+    </>
+  )
+}
+
+function Add({ onClose }) {
+  const { error } = useUI()
+  const [f, setF] = useState({ full_name: '', email: '', temp_password: '' })
+  const [made, setMade] = useState(null)
+  const [busy, setBusy] = useState(false)
+  async function go(e) { e?.preventDefault(); setBusy(true); const b = { ...f }; if (!b.temp_password) delete b.temp_password; try { setMade(await api.post('/superadmin/platform-admins', b)) } catch (x) { error(x) } finally { setBusy(false) } }
+  if (made) return <Modal title="Platform admin added" onClose={onClose} footer={<Button variant="primary" onClick={onClose}>Done</Button>}>
+    <Alert tone="ok">{made.full_name} now has full platform access.</Alert>{made.invite_url && <div className="row"><input className="input mono grow" readOnly value={made.invite_url} aria-label="Activation link" /><CopyButton text={made.invite_url} /></div>}</Modal>
+  return <Modal title="Add platform admin" onClose={onClose} footer={<><Button onClick={onClose}>Cancel</Button><Button variant="primary" busy={busy} onClick={go}>Add</Button></>}>
+    <Alert tone="warn">Platform admins can see and change every organization. Add only people you trust with that.</Alert>
+    <form onSubmit={go}><Input label="Full name" required value={f.full_name} onChange={(e) => setF({ ...f, full_name: e.target.value })} /><Input label="E-mail" type="email" required value={f.email} onChange={(e) => setF({ ...f, email: e.target.value })} /><Input label="Temporary password (optional)" autoComplete="off" value={f.temp_password} onChange={(e) => setF({ ...f, temp_password: e.target.value })} /></form></Modal>
+}
diff --git a/frontend/src/styles/app.css b/frontend/src/styles/app.css
new file mode 100644
index 0000000..d55ba73
--- /dev/null
+++ b/frontend/src/styles/app.css
@@ -0,0 +1,243 @@
+@import './tokens.css';
+
+*, *::before, *::after { box-sizing: border-box; }
+html { -webkit-text-size-adjust: 100%; }
+body {
+  margin: 0; background: var(--paper); color: var(--text);
+  font-family: var(--font-body); font-size: 14.5px; line-height: 1.5;
+  -webkit-font-smoothing: antialiased;
+}
+h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 650; letter-spacing: -0.01em; margin: 0; line-height: 1.2; }
+h1 { font-size: 1.65rem; } h2 { font-size: 1.2rem; } h3 { font-size: 1rem; }
+p { margin: 0; }
+a { color: var(--accent-strong); text-decoration-thickness: 1px; text-underline-offset: 2px; }
+a.btn, .nav a, .side a, .brand, .tabs a, .crumbs a, a.icon-btn, .code-ticket a { text-decoration: none; }
+a.btn.primary { color: var(--on-accent); }
+button, input, select, textarea { font: inherit; color: inherit; }
+code, .mono { font-family: var(--font-mono); font-size: 0.92em; }
+:focus-visible { outline: none; box-shadow: var(--focus); border-radius: var(--radius); }
+.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
+@media (prefers-reduced-motion: reduce) { * { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; } }
+
+/* ---------- buttons ---------- */
+.btn {
+  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
+  height: 36px; padding: 0 14px; border-radius: var(--radius); border: 1px solid var(--line-strong);
+  background: var(--surface); color: var(--text); font-weight: 550; cursor: pointer; white-space: nowrap;
+  transition: background 0.12s, border-color 0.12s;
+}
+.btn:hover:not(:disabled) { background: var(--neutral-soft); }
+.btn:disabled { opacity: 0.5; cursor: not-allowed; }
+.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
+.btn.primary:hover:not(:disabled) { background: var(--accent-strong); border-color: var(--accent-strong); }
+.btn.danger { background: var(--bad); border-color: var(--bad); color: #fff; }
+.btn.danger:hover:not(:disabled) { filter: brightness(0.92); background: var(--bad); }
+.btn.ghost { border-color: transparent; background: transparent; }
+.btn.ghost:hover:not(:disabled) { background: var(--neutral-soft); }
+.btn.sm { height: 30px; padding: 0 10px; font-size: 13px; }
+.btn.lg { height: 46px; padding: 0 22px; font-size: 15.5px; }
+.btn.block { width: 100%; }
+.btn svg { flex: none; }
+.icon-btn { width: 32px; height: 32px; padding: 0; }
+
+/* ---------- forms ---------- */
+.field { display: grid; gap: 5px; margin-bottom: 14px; min-width: 0; }
+.field > label, .label { font-size: 13px; font-weight: 600; color: var(--text-2); }
+.hint { font-size: 12.5px; color: var(--text-3); }
+.err-text { font-size: 12.5px; color: var(--bad); }
+.input, select.input, textarea.input {
+  width: 100%; height: 38px; padding: 0 11px; border: 1px solid var(--line-strong); border-radius: var(--radius);
+  background: var(--surface); transition: border-color 0.12s;
+}
+textarea.input { height: auto; min-height: 84px; padding: 9px 11px; resize: vertical; line-height: 1.45; }
+.input:hover { border-color: var(--text-3); }
+.input:focus { outline: none; border-color: var(--accent); box-shadow: var(--focus); }
+.input.mono { font-family: var(--font-mono); }
+.input-icon { position: relative; }
+.input-icon > svg { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--text-3); pointer-events: none; }
+.input-icon > .input { padding-left: 34px; }
+.row { display: flex; gap: 12px; align-items: center; }
+.row.wrap { flex-wrap: wrap; }
+.row.between { justify-content: space-between; }
+.row.top { align-items: flex-start; }
+.grid { display: grid; gap: 14px; }
+.grid.c2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+.grid.c3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+.grid.c4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+@media (max-width: 760px) { .grid.c2, .grid.c3, .grid.c4 { grid-template-columns: 1fr; } }
+.grow { flex: 1; min-width: 0; }
+.mt { margin-top: 16px; } .mt-lg { margin-top: 28px; } .mb { margin-bottom: 16px; }
+.muted { color: var(--text-3); } .muted-2 { color: var(--text-2); }
+.right { margin-left: auto; }
+.nowrap { white-space: nowrap; }
+.truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+
+.check { display: flex; gap: 9px; align-items: flex-start; cursor: pointer; font-size: 14px; }
+.check input { margin-top: 3px; width: 16px; height: 16px; accent-color: var(--accent); flex: none; }
+.check small { display: block; color: var(--text-3); font-size: 12.5px; }
+.switch { display: flex; gap: 12px; align-items: flex-start; justify-content: space-between; padding: 11px 0; border-bottom: 1px solid var(--line); }
+.switch:last-child { border-bottom: 0; }
+.switch .t { font-weight: 550; } .switch .d { color: var(--text-3); font-size: 12.5px; margin-top: 1px; }
+.toggle { position: relative; width: 38px; height: 22px; flex: none; margin-top: 2px; }
+.toggle input { position: absolute; inset: 0; opacity: 0; cursor: pointer; margin: 0; }
+.toggle span { position: absolute; inset: 0; background: var(--line-strong); border-radius: 22px; transition: background 0.15s; pointer-events: none; }
+.toggle span::after { content: ''; position: absolute; top: 3px; left: 3px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: transform 0.15s; }
+.toggle input:checked + span { background: var(--accent); }
+.toggle input:checked + span::after { transform: translateX(16px); }
+.toggle input:focus-visible + span { box-shadow: var(--focus); }
+.toggle input:disabled + span { opacity: 0.5; }
+
+/* ---------- badges ---------- */
+.badge { display: inline-flex; align-items: center; gap: 5px; height: 22px; padding: 0 8px; border-radius: 11px; font-size: 12px; font-weight: 600; background: var(--neutral-soft); color: var(--text-2); white-space: nowrap; }
+.badge.ok { background: var(--ok-soft); color: var(--ok); }
+.badge.warn { background: var(--warn-soft); color: var(--warn); }
+.badge.bad { background: var(--bad-soft); color: var(--bad); }
+.badge.info { background: var(--info-soft); color: var(--info); }
+.dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; display: inline-block; }
+.dot.live { animation: pulse 1.6s ease-in-out infinite; }
+@keyframes pulse { 50% { opacity: 0.35; } }
+
+/* ---------- page structure ---------- */
+.shell { display: grid; grid-template-columns: var(--sidebar-w) minmax(0, 1fr); min-height: 100vh; }
+.side { background: var(--ink); color: var(--ink-text); position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; padding: 18px 12px; overflow-y: auto; }
+.brand { display: flex; align-items: center; gap: 9px; padding: 4px 8px 18px; color: #fff; font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; text-decoration: none; }
+.brand .mark { width: 26px; height: 26px; border-radius: 7px; background: var(--accent); display: grid; place-items: center; color: #fff; }
+.org-chip { margin: 0 4px 14px; padding: 9px 10px; border: 1px solid var(--ink-line); border-radius: var(--radius); }
+.org-chip b { display: block; color: #fff; font-weight: 600; font-size: 13.5px; }
+.org-chip span { font-size: 12px; color: var(--ink-mute); }
+.nav { display: grid; gap: 2px; }
+.nav-group { margin: 16px 10px 5px; font-size: 11.5px; color: var(--ink-mute); font-weight: 600; letter-spacing: 0.02em; }
+.nav a { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: var(--radius); color: var(--ink-text); text-decoration: none; font-weight: 500; }
+.nav a:hover { background: var(--ink-2); color: #fff; }
+.nav a.active { background: var(--ink-2); color: #fff; box-shadow: inset 3px 0 0 var(--accent); }
+.nav a .count { margin-left: auto; background: var(--bad); color: #fff; font-size: 11px; padding: 0 6px; border-radius: 9px; font-weight: 600; }
+.side-foot { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--ink-line); }
+.side-foot .who { padding: 4px 8px 10px; font-size: 13px; color: #fff; }
+.side-foot .who span { display: block; color: var(--ink-mute); font-size: 12px; overflow: hidden; text-overflow: ellipsis; }
+.side-foot .btn { width: 100%; justify-content: flex-start; color: var(--ink-text); }
+.side-foot .btn:hover { background: var(--ink-2) !important; color: #fff; }
+.main { padding: 26px 34px 60px; max-width: 1280px; width: 100%; min-width: 0; }
+.topbar { display: none; }
+@media (max-width: 920px) {
+  .shell { grid-template-columns: 1fr; }
+  .side { position: fixed; z-index: 40; inset: 0 auto 0 0; width: 260px; transform: translateX(-100%); transition: transform 0.2s; }
+  .side.open { transform: none; }
+  .scrim { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.45); z-index: 30; }
+  .topbar { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: var(--ink); color: #fff; position: sticky; top: 0; z-index: 20; }
+  .main { padding: 18px 16px 50px; }
+}
+.page-head { display: flex; align-items: flex-end; gap: 16px; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; }
+.page-head p { color: var(--text-3); margin-top: 4px; max-width: 70ch; }
+.crumbs { font-size: 13px; color: var(--text-3); margin-bottom: 6px; display: flex; gap: 6px; align-items: center; }
+.crumbs a { color: var(--text-3); text-decoration: none; } .crumbs a:hover { color: var(--accent-strong); }
+
+/* ---------- surfaces: flat panels, hairlines ---------- */
+.panel { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); }
+.panel > .ph { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 18px; border-bottom: 1px solid var(--line); }
+.panel > .pb { padding: 18px; }
+.panel + .panel { margin-top: 16px; }
+.section { padding: 20px 0; border-top: 1px solid var(--line); }
+.section:first-child { border-top: 0; padding-top: 0; }
+.stats { display: flex; flex-wrap: wrap; border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface); margin-bottom: 18px; }
+.stat { flex: 1 1 150px; padding: 14px 18px; border-right: 1px solid var(--line); min-width: 0; }
+.stat:last-child { border-right: 0; }
+.stat .v { font-family: var(--font-display); font-size: 1.7rem; font-weight: 650; line-height: 1.1; }
+.stat .l { color: var(--text-3); font-size: 13px; margin-top: 3px; }
+.stat .s { font-size: 12px; color: var(--text-3); margin-top: 2px; }
+@media (max-width: 700px) { .stat { flex-basis: 50%; border-bottom: 1px solid var(--line); } }
+
+/* ---------- tables ---------- */
+.table-wrap { overflow-x: auto; }
+table.t { width: 100%; border-collapse: collapse; }
+.t th { text-align: left; font-size: 12.5px; font-weight: 600; color: var(--text-3); padding: 10px 14px; border-bottom: 1px solid var(--line); white-space: nowrap; background: var(--surface-2); }
+.t td { padding: 11px 14px; border-bottom: 1px solid var(--line); vertical-align: middle; }
+.t tr:last-child td { border-bottom: 0; }
+.t tbody tr.click { cursor: pointer; }
+.t tbody tr.click:hover td { background: var(--surface-2); }
+.t td.num, .t th.num { text-align: right; font-variant-numeric: tabular-nums; }
+.t .sub { color: var(--text-3); font-size: 12.5px; }
+.t td a.name { color: var(--text); font-weight: 600; text-decoration: none; }
+.t td a.name:hover { color: var(--accent-strong); text-decoration: underline; }
+.pager { display: flex; align-items: center; justify-content: space-between; padding: 10px 14px; border-top: 1px solid var(--line); color: var(--text-3); font-size: 13px; }
+.toolbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin-bottom: 14px; }
+.toolbar .input-icon { flex: 1 1 220px; max-width: 360px; }
+.toolbar select.input { width: auto; min-width: 140px; }
+
+/* ---------- tabs ---------- */
+.tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--line); margin-bottom: 20px; overflow-x: auto; }
+.tabs a, .tabs button { padding: 10px 14px; border: 0; background: none; cursor: pointer; color: var(--text-3); font-weight: 550; text-decoration: none; border-bottom: 2px solid transparent; margin-bottom: -1px; white-space: nowrap; display: inline-flex; gap: 7px; align-items: center; }
+.tabs a:hover, .tabs button:hover { color: var(--text); }
+.tabs a.active, .tabs button.active { color: var(--accent-strong); border-bottom-color: var(--accent); }
+
+/* ---------- modal + toast ---------- */
+.overlay { position: fixed; inset: 0; background: rgba(10, 18, 24, 0.55); z-index: 100; display: grid; place-items: center; padding: 16px; animation: fade 0.12s; }
+@keyframes fade { from { opacity: 0; } }
+.modal { background: var(--surface); border-radius: var(--radius-lg); box-shadow: var(--shadow-pop); width: min(560px, 100%); max-height: calc(100vh - 32px); display: flex; flex-direction: column; animation: rise 0.16s ease-out; }
+.modal.wide { width: min(820px, 100%); }
+@keyframes rise { from { transform: translateY(8px); opacity: 0; } }
+.modal > header { padding: 16px 20px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; gap: 12px; }
+.modal > .body { padding: 20px; overflow-y: auto; }
+.modal > footer { padding: 14px 20px; border-top: 1px solid var(--line); display: flex; justify-content: flex-end; gap: 10px; }
+.toasts { position: fixed; right: 16px; bottom: 16px; z-index: 200; display: grid; gap: 8px; max-width: min(380px, calc(100vw - 32px)); }
+.toast { background: var(--ink); color: #fff; padding: 11px 14px; border-radius: var(--radius); box-shadow: var(--shadow-pop); display: flex; gap: 10px; align-items: flex-start; animation: rise 0.18s ease-out; border-left: 3px solid var(--accent); }
+.toast.error { border-left-color: var(--bad); }
+
+/* ---------- misc ---------- */
+.alert { display: flex; gap: 10px; padding: 11px 14px; border-radius: var(--radius); background: var(--info-soft); color: var(--info); font-size: 13.5px; margin-bottom: 14px; border: 1px solid transparent; }
+.alert.warn { background: var(--warn-soft); color: var(--warn); }
+.alert.bad { background: var(--bad-soft); color: var(--bad); }
+.alert.ok { background: var(--ok-soft); color: var(--ok); }
+.alert svg { flex: none; margin-top: 2px; }
+.alert a { color: inherit; font-weight: 600; }
+.empty { text-align: center; padding: 44px 20px; color: var(--text-3); }
+.empty h3 { color: var(--text); margin-bottom: 6px; }
+.empty p { max-width: 46ch; margin: 0 auto 14px; }
+.spinner { width: 18px; height: 18px; border: 2px solid var(--line-strong); border-top-color: var(--accent); border-radius: 50%; animation: spin 0.7s linear infinite; display: inline-block; }
+@keyframes spin { to { transform: rotate(360deg); } }
+.loading { display: grid; place-items: center; padding: 60px; }
+.meter { height: 6px; background: var(--neutral-soft); border-radius: 3px; overflow: hidden; }
+.meter > i { display: block; height: 100%; background: var(--accent); border-radius: 3px; }
+.meter.warn > i { background: var(--warn); } .meter.bad > i { background: var(--bad); }
+.kv { display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 8px 16px; font-size: 14px; }
+.kv dt { color: var(--text-3); } .kv dd { margin: 0; min-width: 0; overflow-wrap: anywhere; }
+@media (max-width: 600px) { .kv { grid-template-columns: 1fr; gap: 0; } .kv dd { margin-bottom: 8px; } }
+.chips { display: flex; flex-wrap: wrap; gap: 6px; }
+.chip { display: inline-flex; align-items: center; gap: 4px; padding: 3px 9px; background: var(--neutral-soft); border-radius: 12px; font-size: 12.5px; }
+.chip button { border: 0; background: none; cursor: pointer; padding: 0; color: var(--text-3); display: grid; }
+.avatar { width: 30px; height: 30px; border-radius: 50%; background: var(--accent-soft); color: var(--accent-strong); display: inline-grid; place-items: center; font-weight: 700; font-size: 12px; flex: none; }
+.risk { display: inline-flex; align-items: center; gap: 7px; font-variant-numeric: tabular-nums; font-weight: 600; }
+.risk .bar { width: 44px; height: 5px; background: var(--neutral-soft); border-radius: 3px; overflow: hidden; }
+.risk .bar i { display: block; height: 100%; }
+.risk.low { color: var(--ok); } .risk.low .bar i { background: var(--ok); }
+.risk.medium { color: var(--warn); } .risk.medium .bar i { background: var(--warn); }
+.risk.high { color: var(--bad); } .risk.high .bar i { background: var(--bad); }
+
+/* ---------- the test code ticket (the product's signature object) ---------- */
+.ticket { display: inline-flex; align-items: stretch; border: 1.5px dashed var(--accent); border-radius: var(--radius-lg); background: var(--accent-soft); color: var(--accent-strong); overflow: hidden; }
+.ticket .code { font-family: var(--font-mono); font-weight: 600; letter-spacing: 0.16em; font-size: 1.5rem; padding: 10px 16px; }
+.ticket button { border: 0; border-left: 1.5px dashed var(--accent); background: transparent; color: inherit; padding: 0 12px; cursor: pointer; display: grid; place-items: center; }
+.ticket button:hover { background: rgba(15, 118, 110, 0.14); }
+.ticket.sm .code { font-size: 1rem; padding: 4px 10px; letter-spacing: 0.12em; }
+.ticket.sm { border-width: 1px; border-radius: var(--radius); }
+
+/* ---------- charts ---------- */
+.chart text { fill: var(--text-3); font-size: 11px; font-family: var(--font-body); }
+.chart .grid-line { stroke: var(--line); stroke-width: 1; }
+.chart .bar { fill: var(--accent); }
+.chart .bar:hover { fill: var(--accent-strong); }
+.legend { display: flex; gap: 14px; flex-wrap: wrap; font-size: 12.5px; color: var(--text-2); }
+.legend i { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 6px; }
+.hbar { display: grid; grid-template-columns: minmax(80px, 1.2fr) 3fr 52px; gap: 10px; align-items: center; padding: 5px 0; font-size: 13.5px; }
+.hbar .track { height: 8px; background: var(--neutral-soft); border-radius: 4px; overflow: hidden; }
+.hbar .track i { display: block; height: 100%; background: var(--accent); }
+.hbar .v { text-align: right; font-variant-numeric: tabular-nums; color: var(--text-2); }
+
+/* ---------- auth + public pages ---------- */
+.auth { min-height: 100vh; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
+.auth-art { background: var(--ink); color: var(--ink-text); padding: 48px; display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden; }
+.auth-art h2 { color: #fff; font-size: 2.2rem; max-width: 16ch; line-height: 1.1; }
+.auth-art p { max-width: 42ch; margin-top: 14px; color: var(--ink-text); }
+.auth-form { display: grid; place-items: center; padding: 32px 20px; }
+.auth-card { width: min(400px, 100%); }
+.auth-card h1 { margin-bottom: 6px; }
+@media (max-width: 860px) { .auth { grid-template-columns: 1fr; } .auth-art { display: none; } }
diff --git a/frontend/src/styles/pages.css b/frontend/src/styles/pages.css
new file mode 100644
