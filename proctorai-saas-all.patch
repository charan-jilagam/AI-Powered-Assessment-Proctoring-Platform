-+
-+class _TtlStore:
-+    """Small thread-safe per-key store that forgets idle keys (so abandoned sessions don't leak)."""
-+
-+    def __init__(self, ttl_seconds: float, clock: Callable[[], float]):
-+        self._ttl = ttl_seconds
-+        self._clock = clock
-+        self._lock = threading.Lock()
-+        self._data: dict[Hashable, tuple[float, object]] = {}
