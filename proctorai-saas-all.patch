+
+
+@router.post("/organizations", status_code=201)
+def create_org(body: OrgCreate, request: Request, user: models.User = Depends(auth.require_super_admin), db: Session = Depends(get_db)):
+    plan = _plan_by_code(db, body.plan_code)
