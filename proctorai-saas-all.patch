-+export default function AuthProvider({ children }) {
-+  const [user, setUser] = useState(null);
-+  const [loading, setLoading] = useState(Boolean(getToken()));
-+
-+  const refresh = useCallback(async () => {
-+    if (!getToken()) {
-+      setUser(null);
-+      setLoading(false);
-+      return null;
-+    }
-+    try {
-+      const me = await apiCall("/auth/me");
-+      setUser(me);
-+      return me;
