+        </aside>
+      </div>
+
+      {fsLost && cfg.fullscreen_required && (
+        <div className="overlay" style={{ zIndex: 150 }}><div className="modal" role="alertdialog" aria-label="Return to fullscreen"><div className="body" style={{ textAlign: 'center', padding: 28 }}>
