+[alembic]
+script_location = alembic
+prepend_sys_path = .
+# The URL comes from DATABASE_URL (see alembic/env.py); never hard-code credentials here.
+
+[loggers]
+keys = root,sqlalchemy,alembic
+
+[handlers]
+keys = console
+
+[formatters]
