@@ -0,0 +1,33 @@
+# Copy to .env and fill in. NEVER commit .env.
+# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
+
+# ---- required --------------------------------------------------------------
+POSTGRES_PASSWORD=change-me
+SECRET_KEY=change-me-long-random-string
+# Public URL where users open the app (used in e-mailed links and CORS)
+FRONTEND_URL=http://localhost:8080
+
+# ---- first super admin (created on first start if no super admin exists) ----
+SUPERADMIN_EMAIL=owner@yourcompany.com
+SUPERADMIN_PASSWORD=change-me-at-least-10-chars-1
+SUPERADMIN_NAME=Platform Owner
+
+# ---- e-mail (optional: without SMTP every message is only stored in the outbox, visible to the super admin) ----
+SMTP_HOST=
+SMTP_PORT=587
+SMTP_USER=
+SMTP_PASSWORD=
+SMTP_STARTTLS=true
+MAIL_FROM=ProctorAI <no-reply@yourcompany.com>
+
+# ---- optional ---------------------------------------------------------------
+# Redis makes rate limits shared across workers (otherwise each worker counts separately)
+REDIS_URL=
+WEB_CONCURRENCY=2
+TRIAL_DAYS=14
+AI_PROCTORING_ENABLED=true
+# Build the API image with AI libraries:  WITH_AI=true docker compose build backend
+WITH_AI=false
+
+# ---- Judge0 (coding questions): also change the passwords in judge0.conf --------
+JUDGE0_URL=http://judge0-server:2358
diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..8d3ca1a
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,31 @@
+name: CI
+on:
+  push:
+  pull_request:
+
+jobs:
+  backend:
+    runs-on: ubuntu-latest
+    defaults: { run: { working-directory: backend } }
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with: { python-version: "3.12", cache: pip }
+      - run: pip install -r requirements.txt -r requirements-dev.txt
+      - run: python -m pytest tests -q
+      - name: Migrations apply cleanly and match the models
+        env:
+          DATABASE_URL: sqlite:///./ci.db
+          SECRET_KEY: ci-secret-key-0123456789abcdef0123456789
+        run: alembic upgrade head && alembic check
+
+  frontend:
+    runs-on: ubuntu-latest
+    defaults: { run: { working-directory: frontend } }
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with: { node-version: 22, cache: npm, cache-dependency-path: frontend/package-lock.json }
+      - run: npm ci
+      - run: npm run lint
+      - run: npm run build
