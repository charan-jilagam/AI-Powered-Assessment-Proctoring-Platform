+            </nav>
+
+            <div style={styles.main}>
+                <div style={styles.eyebrow}>ADMIN CONSOLE · EXAM #{examId}</div>
+                <h1 style={styles.title}>Coding Problems</h1>
+                <p style={styles.subtitle}>
