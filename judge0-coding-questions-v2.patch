+                problems: parsed.map(cleanProblem),
+            });
+            setSuccess(`Imported ${res.count} problem${res.count !== 1 ? "s" : ""}.`);
+            await load();
+        } catch (err) {
+            setError(err.message);
+        }
+    }
+
+    async function deleteProblem(problem) {
