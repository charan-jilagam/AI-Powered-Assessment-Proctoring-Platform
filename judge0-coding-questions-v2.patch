+                                        </div>
+                                    </div>
+                                    <div style={styles.actionRow}>
+                                        <button onClick={() => setOpenProblem(openProblem === p.id ? null : p.id)} style={styles.secondaryBtn}>
+                                            {openProblem === p.id ? "Hide details" : "View details"}
+                                        </button>
