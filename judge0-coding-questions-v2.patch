+        if (problemError) {
+            setError(problemError);
+            return;
+        }
+        setSaving(true);
+        try {
+            await apiCall(`/exams/${examId}/coding-problems`, "POST", cleanProblem(adding));
+            setSuccess("Problem added.");
+            setAdding(null);
+            await load();
+        } catch (err) {
+            setError(err.message);
+        } finally {
+            setSaving(false);
+        }
+    }
+
+    async function importJson(file) {
