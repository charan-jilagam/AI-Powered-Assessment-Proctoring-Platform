# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- required --------------------------------------------------------------
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-long-random-string
# Public URL where users open the app (used in e-mailed links and CORS)
FRONTEND_URL=http://localhost:8080

# ---- first super admin (created on first start if no super admin exists) ----
SUPERADMIN_EMAIL=owner@yourcompany.com
SUPERADMIN_PASSWORD=change-me-at-least-10-chars-1
SUPERADMIN_NAME=Platform Owner

# ---- e-mail (optional: without SMTP every message is only stored in the outbox, visible to the super admin) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=ProctorAI <no-reply@yourcompany.com>

# ---- optional ---------------------------------------------------------------
# Redis makes rate limits shared across workers (otherwise each worker counts separately)
REDIS_URL=
WEB_CONCURRENCY=2
TRIAL_DAYS=14
AI_PROCTORING_ENABLED=true
# Build the API image with AI libraries:  WITH_AI=true docker compose build backend
WITH_AI=false

# ---- Judge0 (coding questions): also change the passwords in judge0.conf --------
JUDGE0_URL=http://judge0-server:2358
