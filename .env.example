# Local development: copy to backend/.env (it is git-ignored). NEVER commit real values.
# On Render, set these under Environment (see render.yaml) instead of using a file.
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(64))"

# ---- required ---------------------------------------------------------------
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?appName=Cluster0
MONGODB_DB=orvexa
JWT_SECRET=change-me-long-random-string-at-least-32-chars
JWT_EXPIRE=7d
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- first super admin (created on first start if missing) -------------------
SUPERADMIN_EMAIL=owner@yourcompany.com
SUPERADMIN_PASSWORD=change-me-at-least-10-chars-1
SUPERADMIN_NAME=Platform Owner

# ---- Cloudinary: proctoring evidence (without it images go to local disk, which Render wipes on deploy) ----
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# or: CLOUDINARY_CLOUD_NAME= / CLOUDINARY_API_KEY= / CLOUDINARY_API_SECRET=

# ---- Razorpay: plan payments (INR). Webhook URL: https://YOUR-APP/api/billing/webhook, event payment.captured ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- e-mail (optional: without SMTP every message is only stored in the outbox, visible to the super admin) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=ORVEXA <no-reply@yourcompany.com>

# ---- optional ---------------------------------------------------------------
REDIS_URL=
TRIAL_DAYS=14
AI_PROCTORING_ENABLED=true
JUDGE0_URL=
